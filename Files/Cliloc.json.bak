  },
  "1043135": {
    "ENU": "Must stay. . .on feet. . ."
  },
  "1043136": {
    "ENU": "Ooooh, that doth hurt. . ."
  },
  "1043137": {
    "ENU": "Am I dying?"
  },
  "1043138": {
    "ENU": "Whatever shall my family do without me?"
  },
  "1043139": {
    "ENU": "I hope the guards catch thee, scum!"
  },
  "1043140": {
    "ENU": "Ooo. . . that doth hurt."
  },
  "1043141": {
    "ENU": "Must I die?"
  },
  "1043142": {
    "ENU": "Curse thee!"
  },
  "1043143": {
    "ENU": "I curse thee and thy offspring for this deed!"
  },
  "1043144": {
    "ENU": "I shall haunt thee for this deed!"
  },
  "1043145": {
    "ENU": "I spit on thee. . ."
  },
  "1043146": {
    "ENU": "Ha! I knew that I could do it!"
  },
  "1043147": {
    "ENU": "Thou shouldst not have messed with me!"
  },
  "1043148": {
    "ENU": "Die, you weak, pathetic fool!"
  },
  "1043149": {
    "ENU": "Thou deservest to die!"
  },
  "1043150": {
    "ENU": "There, that taketh care of thee."
  },
  "1043151": {
    "ENU": "So perish those that challenge me!"
  },
  "1043152": {
    "ENU": "Thou shouldn’t not have fought me."
  },
  "1043153": {
    "ENU": "May thy soul rest in peace."
  },
  "1043154": {
    "ENU": "May thy shade wander the wilderness forever!"
  },
  "1043155": {
    "ENU": "Have done with thee."
  },
  "1043156": {
    "ENU": "Ha! Thou art inept!"
  },
  "1043157": {
