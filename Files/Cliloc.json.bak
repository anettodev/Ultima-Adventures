  },
  "1115296": {
    "ENU": "Your character will always run when using the right mouse button, regardless of mouse distance from your character."
  },
  "1115297": {
    "ENU": "While in War mode, your character will automatically attack any mob that is selected. This option only works when the \"Legacy Targeting\" option is turned off."
  },
  "1115298": {
    "ENU": "Displays a warning dialog if you are about to perform a criminal act while in a non-consensual PvP zone."
  },
  "1115299": {
    "ENU": "Requires the shift key when dragging stacked items in order to split them apart."
