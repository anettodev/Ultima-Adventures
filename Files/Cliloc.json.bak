  "1016378": {
    "ENU": "The maze is South, thou shouldst head North!",
    "PTB": "O labirinto é ao Sul, você deve ir para o Norte!"
  },
  "1016379": {
    "ENU": "The maze of Relvinian the Mad is nigh!  Hasten from this spot!",
    "PTB": "O labirinto de Relvinian, o Louco, está próximo! Apresse-se deste local!"
  },
  "1016380": {
    "ENU": "The maze of the mad mage Relvinian is close!  Turn back now if thou dost care for thy life!",
    "PTB": "O labirinto do mago louco Relvinian está próximo! Volte agora se você se importa com sua vida!"
  },
  "1016381": {
    "ENU": "The true path to Order is through Chaos and the cleansing of all life.",
    "PTB": "O verdadeiro caminho para a Ordem é através do Caos e da purificação de toda vida."
  },
  "1016382": {
    "ENU": "There is nothing in Relvinian's maze but death.  Mark my word, travelers.",
    "PTB": "Não há nada no labirinto de Relvinian além da morte. Marque minhas palavras, viajantes."
  },
  "1016383": {
    "ENU": "This is the master guild object. Do not delete!",
    "PTB": "Este é o objeto mestre da guilda. Não apague!"
  },
  "1016384": {
    "ENU": "This is the master switch stone object. Do NOT delete!",
    "PTB": "Esta é a pedra-interruptor mestra. NÃO APAGUE!"
  },
  "1016385": {
    "ENU": "This means YOU!",
    "PTB": "Isso significa VOCÊ!"
  },
  "1016386": {
    "ENU": "This tile will teleport you to the ground.",
    "PTB": "Este tile vai te teleportar para o chão."
  },
  "1016387": {
    "ENU": "Those washed ashore from islands may follow the road south to Delucia. Never leave the road lest ye be eaten up by wild beasts!",
    "PTB": "Aqueles que chegaram à costa de ilhas podem seguir a estrada para o sul até Delucia. Nunca deixe a estrada, ou será devorado por bestas selvagens!"
  },
  "1016388": {
    "ENU": "Thou has come too close.  Turn back now if thou dost treasure thy soul!",
    "PTB": "Você chegou muito perto. Volte agora se valoriza sua alma!"
  },
  "1016389": {
    "ENU": "Thou hast nothing to fear from Relvinian's maze...unless thou dost fear death!",
    "PTB": "Você não tem nada a temer do labirinto de Relvinian... a menos que tema a morte!"
  },
