  },
  "1061290": {
    "ENU": "Temporarily reduces Target's Dexterity."
  },
  "1061291": {
    "ENU": "Creates random food item in Caster’s backpack."
  },
  "1061292": {
    "ENU": "Temporarily reduces Target’s Intelligence."
  },
  "1061293": {
    "ENU": "Heals Target of a small amount of lost Hit Points."
  },
  "1061294": {
    "ENU": "Shoots a magical arrow at Target, which deals Fire damage."
  },
  "1061295": {
    "ENU": "Temporarily allows Target to see in darkness."
  },
  "1061296": {
    "ENU": "Increases the Caster’s Physical Resistance while reducing their Elemental Resistances.  The Caster’s Inscription skill adds a bonus to the amount of Physical Resist applied. Active until spell is deactivated by re-casting the spell on the same Target."
  },
  "1061297": {
    "ENU": "Temporarily reduces Target’s Strength."
  },
  "1061298": {
    "ENU": "Temporarily increases Target’s Dexterity."
  },
  "1061299": {
    "ENU": "Temporarily increases Target’s Intelligence."
  },
  "1061300": {
    "ENU": "Attempts to neutralize poisons affecting the Target."
  },
  "1061301": {
    "ENU": "Affects the Target with a chilling effect, dealing Cold damage.  The closer the Target is to the Caster, the more damage is dealt."
  },
  "1061302": {
    "ENU": "Places an explosive magic ward on a container that deals Fire damage to the next person to open it. You can also target the ground and place a random trap for the careless."
  },
  "1061303": {
    "ENU": "Deactivates a magical trap on a container, or you can cast on yourself to summon an orb of trap detection. This orb would remain in your pack and help you avoid hidden traps.\n"
  },
  "1061304": {
    "ENU": "Prevents the Target from having their spells disrupted, but lowers their Physical Resistance and ability to Resist Spells.  Active until the spell is deactivated by recasting on the same Target."
  },
  "1061305": {
    "ENU": "Temporarily increases Target’s Strength."
  },
  "1061306": {
    "ENU": "Temporarily increases Target’s Strength, Dexterity, and Intelligence."
  },
  "1061307": {
    "ENU": "Shoots a ball of roiling flames at a Target, dealing Fire damage."
  },
  "1061308": {
    "ENU": "Magically lock a container or dungeon door, but also lock a creatures soul in an iron flask."
  },
  "1061309": {
    "ENU": "The Target is afflicted by poison, of a strength determined by the Caster’s Magery and Poison skills, and the distance from the Target."
  },
  "1061310": {
    "ENU": "Allows the Caster to Use an item at a distance. You may also be able to grab smaller objects from a distance and put them in your pack."
  },
  "1061311": {
    "ENU": "Caster is transported to the Target Location."
  },
  "1061312": {
    "ENU": "Unlocks a magical lock or low level normal lock."
  },
  "1061313": {
    "ENU": "Creates a temporary wall of stone that blocks movement."
  },
  "1061314": {
    "ENU": "Neutralizes poisons on all characters within a small radius around the caster."
  },
  "1061315": {
    "ENU": "Applies the Protection spell to all valid targets within a small radius around the Target Location."
  },
  "1061316": {
    "ENU": "Lowers the Strength, Dexterity, and Intelligence of the Target. When cast during Player vs. Player combat the spell also reduces the target's maximum resistance values."
  },
  "1061317": {
    "ENU": "Summons a wall of fire that deals Fire damage to all who walk through it"
  },
  "1061318": {
    "ENU": "Heals the target of a medium amount of lost Hit Points."
  },
  "1061319": {
    "ENU": "Strikes the Target with a bolt of lightning, which deals Energy damage."
  },
  "1061320": {
    "ENU": "Temporarily removes an amount of mana from the Target, based on a comparison between the Caster’s Evaluate Intelligence skill and the Target’s Resist Spells skill."
  },
  "1061321": {
    "ENU": "Caster is transported to the location marked on the Target rune. If a ship key is target, Caster is transported to the boat the key opens."
  },
  "1061322": {
    "ENU": "Summons a whirling pillar of blades that selects a Target to attack based off its combat strength and proximity.  The Blade Spirit disappears after a set amount of time.  Requires 2 pet control slots."
  },
  "1061323": {
    "ENU": "Destroys one tile of a target Field spell."
  },
  "1061324": {
    "ENU": "Disguises the Caster with a randomly generated appearance and name."
  },
  "1061325": {
    "ENU": "Causes the magery spells cast at you to be reflected back toward the one who cast it. The better your magery and evaulate intelligence, the more magic you can reflect back before the spell wears off. You will need a diamond to make this spell work, along with the reagents."
  },
  "1061326": {
    "ENU": "Deals Cold damage to the Target based off Caster's Magery and Intelligence."
  },
  "1061327": {
    "ENU": "Immobilizes the Target for a brief amount of time.  The Target’s Resisting Spells skill affects the Duration of the immobilization."
  },
  "1061328": {
    "ENU": "Conjures a wall of poisonous vapor that poisons anything that walks through it.  The strength of the Poison is based off of the Caster’s Magery and Poison skills."
  },
  "1061329": {
    "ENU": "Summons a random creature as a Pet for a limited duration.  The strength of the summoned creature is based off of the Caster’s Magery skill."
  },
  "1061330": {
    "ENU": "Attempts to Dispel a summoned creature, causing it to disappear from the world. The Dispel difficulty is affected by the Magery skill of the creature’s owner."
  },
  "1061331": {
    "ENU": "Fires a bolt of magical force at the Target, dealing Energy damage."
  },
  "1061332": {
    "ENU": "Strikes the Target with an explosive blast of energy, dealing Fire damage."
  },
  "1061333": {
    "ENU": "Temporarily causes the Target to become invisible."
  },
  "1061334": {
    "ENU": "Binds a rune to the Caster’s current Location.  The Mage’s Recall spell and the Paladin’s Sacred Journey ability can both be used on the rune to teleport the Caster to the location of binding."
  },
  "1061335": {
    "ENU": "Casts the Curse spell on a Target, and any creatures within a two tile radius."
  },
  "1061336": {
    "ENU": "Conjures a field of paralyzing energy that affects any creature that enters it with the effects of the Paralyze spell."
  },
  "1061337": {
    "ENU": "Reveals the presence of any invisible or hiding creatures or players within a radius around the targeted tile."
  },
  "1061338": {
    "ENU": "Damages nearby targets with a series of lightning bolts that deal Energy damage."
  },
  "1061339": {
    "ENU": "Conjures a temporary field of energy on the ground at the Target Location that blocks all movement."
  },
  "1061340": {
    "ENU": "Envelopes the target in a column of magical flame the deals Fire damage."
  },
  "1061341": {
    "ENU": "Targeting a rune marked with the Mark spell opens a temporary portal to the rune’s marked location.  The portal can be used by anyone to travel to that location."
  },
  "1061342": {
    "ENU": "Drains mana from the Target and transfers it to the Caster. The amount of mana drained is determined by a comparison between the Caster’s Evaluate Intelligence skill and the Target’s Resisting Spells skill"
  },
  "1061343": {
    "ENU": "Attempts to dispel any summoned creature within an eight tile radius."
  },
  "1061344": {
    "ENU": "Summons a swarm of fiery meteors that strike all targets within a radius around the Target Location.  The total Fire damage dealt is split between all Targets of the spell."
  },
  "1061345": {
    "ENU": "Temporarily transforms the Caster into a creature selected from a specified list.  While polymorphed, other players will see the Caster as a criminal."
  },
  "1061346": {
    "ENU": "Causes a violent shaking of the earth that damages all nearby creatures and characters."
  },
  "1061347": {
    "ENU": "Summons a spinning mass of energy that selects a Target to attack based off its intelligence and proximity.  The Energy Vortex disappears after a set amount of time. Requires 2 pet control slots."
  },
  "1061348": {
    "ENU": "Resurrects another or summons a magical item to resurrect yourself at a later time."
  },
  "1061349": {
    "ENU": "An air elemental is summoned to serve the Caster. Requires 2 pet control slots."
  },
  "1061350": {
    "ENU": "A daemon is summoned to serve the Caster. Results in a large Karma loss for the Caster. Requires 4 pet control slots."
  },
  "1061351": {
    "ENU": "An earth elemental is summoned to serve the caster. Requires 2 pet control slots"
  },
  "1061352": {
    "ENU": "A fire elemental is summoned to serve the caster. Requires 4 pet control slots."
  },
  "1061353": {
    "ENU": "A water elemental is summoned to serve the caster. Requires 3 pet control slots."
  },
  "1061354": {
    "ENU": ""
  },
  "1061355": {
    "ENU": ""
  },
