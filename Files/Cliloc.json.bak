  },
  "1076004": {
    "ENU": "City Selection"
  },
  "1076005": {
    "ENU": "Welcome to the home of ~1_OWNER_NAME~. Please keep your shoes off the furniture."
  },
  "1076006": {
    "ENU": "Announcing the arrival of the ~1_VISITOR_TITLE~ ~2_VISITOR_NAME~. The ~3_OWNER_SEX~ of the house bids you welcome."
  },
  "1076007": {
    "ENU": "My ~1_OWNER_SEX~, you have a visitor! ~2_VISITOR_TITLE~ ~3_VISITOR_NAME~ is awaiting your presence."
  },
  "1076008": {
    "ENU": "Welcome the the humble abode of ~1_OWNER_TITLE~ ~2_OWNER_NAME~, please remove your shoes, and have a seat where you may find one."
  },
  "1076009": {
    "ENU": "Ahh, greetings to ~1_VISITOR_TITLE~ ~2_VISITOR_NAME~. Your coming here was foreseen, and I alone know of your purpose."
  },
  "1076010": {
    "ENU": "*squints* Not you again! Fine, fine... whatever... come on in, I suppose. *sighs*"
  },
  "1076011": {
    "ENU": "Attention, attention! All hail the arrival of the ~1_TITLE~ ~2_NAME~!"
  },
  "1076012": {
    "ENU": "Make way ye unwashed hordes! Clear the road! For ~1_TITLE~ ~2_NAME~ has business more important than yours!"
  },
  "1076013": {
    "ENU": "~1_TITLE~ ~2_NAME~ approaches! Be ye prepared to kneel before their indomitable presence! And remember, tribute is to be only in gold!"
  },
  "1076014": {
    "ENU": "Throw down your capes and kerchiefs! Let the petals be strewn! For the ~1_TITLE~ ~2_NAME~ approacheth!"
  },
  "1076015": {
    "ENU": "Death Inverted is the door that will not close, the old habit that returns to repeat a lesson. A transition, but perhaps not to the state you need."
  },
  "1076016": {
    "ENU": "The Inverted Wheel does not spin. There is no movement to propel you in the direction you need to go. You may feel off your path, or unable to push ahead."
  },
  "1076017": {
    "ENU": "Inverted Justice seeks fairness, honesty, but truth is difficult to find. You may be unwilling to consider all options or unwilling to accept responsibility for your actions."
  },
  "1076018": {
    "ENU": "The Inverted Fool lacks the faith to begin a journey. You may not be ready to start anew. You may fear, based on past experience, to trust what you will find on this new path."
  },
  "1076019": {
    "ENU": "The Inverted Hanged Man has not found conclusion; he has not accepted his fate. Your perspective may be too narrow to bring events to a close."
  },
  "1076020": {
    "ENU": "The Inverted High Priestess is active in events where she should be more passive. Perhaps you cannot pull back to view the bigger picture objectively. You may be too involved."
  },
  "1076021": {
    "ENU": "The Inverted Magus seeks, but has not yet found, his inner power. You may be distracted or your goals may not be clear enough. You may not be able to focus your energy in a clear direction."
  },
  "1076022": {
    "ENU": "The Inverted Star is uninspired. The light at the end of the tunnel may not be as bright as you had hoped. Could bring a mild calming, but not true serenity."
  },
  "1076023": {
    "ENU": "The Inverted Tower represents a sudden upheaval, a breakthrough on the horizon. An experience may not humble you as you need. A realization may be just out of reach."
  },
  "1076024": {
    "ENU": "The Inverted World does not fulfill. Accomplishments may not be as great as they seemed they would be. You may not have quite what they expected."
  },
  "1076025": {
    "ENU": "Ask your question"
  },
  "1076026": {
    "ENU": "Heartwood"
  },
  "1076027": {
    "ENU": "Ocllo"
  },
  "1076028": {
    "ENU": "Please contact a GM about this item."
  },
  "1076029": {
    "ENU": "What sort of shop do you seek?"
  },
  "1076030": {
    "ENU": "A Contract for a Personal Attendant"
  },
  "1076031": {
    "ENU": "Guide (Male)"
  },
  "1076032": {
    "ENU": "Guide (Female)"
  },
  "1076033": {
    "ENU": "Herald (Male)"
  },
  "1076034": {
    "ENU": "Herald (Female)"
  },
  "1076035": {
    "ENU": "Lucky Dealer (Male)"
  },
  "1076036": {
    "ENU": "Lucky Dealer (Female)"
  },
  "1076037": {
    "ENU": "Fortune Teller (Female)"
  },
  "1076038": {
    "ENU": "Welcome to the home of ~1_OWNER_NAME~. Please keep your shoes off the furniture."
  },
  "1076039": {
    "ENU": "Announcing the arrival of the ~1_VISITOR_TITLE~ ~2_VISITOR_NAME~. The ~3_OWNER_SEX~ of the house bids you welcome."
  },
  "1076040": {
    "ENU": "My ~1_OWNER_SEX~, you have a visitor! ~2_VISITOR_TITLE~ ~3_VISITOR_NAME~ is awaiting your presence."
  },
  "1076041": {
    "ENU": "Welcome the the humble abode of ~1_OWNER_TITLE~ ~2_OWNER_NAME~, please remove your shoes, and have a seat where you may find one."
  },
  "1076042": {
    "ENU": "Ahh, greetings to ~1_VISITOR_TITLE~ ~2_VISITOR_NAME~. Your coming here was foreseen, and I alone know of your purpose."
  },
  "1076043": {
    "ENU": "*squints* Not you again! Fine, fine... whatever... come on in, I suppose. *sighs*"
  },
  "1076044": {
    "ENU": "Attention, attention! All hail the arrival of the ~1_TITLE~ ~2_NAME~!"
  },
  "1076045": {
    "ENU": "Make way ye unwashed hordes! Clear the road! For ~1_TITLE~ ~2_NAME~ has business more important than yours!"
  },
  "1076046": {
    "ENU": "~1_TITLE~ ~2_NAME~ approaches! Be ye prepared to kneel before their indomitable presence! And remember, tribute is to be only in gold!"
  },
  "1076047": {
    "ENU": "Throw down your capes and kerchiefs! Let the petals be strewn! For the ~1_TITLE~ ~2_NAME~ approacheth!"
  },
  "1076048": {
    "ENU": "~1_TITLE~ ~2_NAME~ has arrived! Let the drinks flow! Let the festivities commence! And you there, with the pig, get that beast on a skewer!"
  },
  "1076049": {
    "ENU": "Let the ~1_SAME_SEX~ cower and the ~2_OPPOSITE_SEX~ swoon, for now approaches the ~3_TITLE~ ~4_NAME~."
  },
  "1076050": {
    "ENU": "Sorry, we are unable to get to the destination."
  },
  "1076051": {
    "ENU": "We have reached our destination"
  },
  "1076052": {
    "ENU": "Clicking \"OK\" will create a Personal Attendant contract bound to you. You will not be able to trade it to another player, and only you will be able to use it."
  },
  "1076053": {
    "ENU": "You already have an attendant."
  },
  "1076054": {
    "ENU": "Welcome to this humble marketplace. If you need any assistance ~1_OWNER_TITLE~ ~2_OWNER_NAME~ will be glad to help you."
  },
  "1076055": {
    "ENU": "Come Friend! Enter ~1_OWNER_TITLE~ ~2_OWNER_NAME~'s wondrous shop of many things! If you can't find it here, I suggest you go somewhere else!"
  },
  "1076056": {
    "ENU": "*Looks ~1_VISITOR_NAME~ over with narrowed eyes, scowling, and points to the sign on the wall* \"Reagents for spell casting only, Please do not eat!\""
  },
  "1076057": {
    "ENU": "The Fool stumbles headlong, blind, into danger, not seeing the consequences. You are starting on a new path. Trust that you will find your way."
  },
  "1076058": {
    "ENU": "The Magus knows of his potential. He acts with focus, without distractions, and can be a powerful creative force, centered on producing the results he wants. Direct your talents to make what is possible reality."
  },
  "1076059": {
    "ENU": "The High Priestess is inactive, passive, allowing things to take their own path. She is intuitive, and trusts herself, her dreams and her imagination. Be open to the bigger picture. Let events unfold as they may."
  },
  "1076060": {
    "ENU": "The Wheel of Fortune shows a turning point. Allow yourself to get swept up in events. Be involved, aware and have a greater perspective."
  },
  "1076061": {
    "ENU": "Justice shows respect for fairness, honesty and ethics. Consider all sides of an issue. Seek balance in the decision to come. Accept responsibility for your decisions."
  },
  "1076062": {
    "ENU": "The Hanged Man is at the end of his struggle; he has accepted his fate. Live in the moment. See things from a new perspective. Don't be afraid to change your ways."
  },
  "1076063": {
    "ENU": "Death is an ending, the closing of a door. The past is behind you. Shed old habits, and eliminate what is unnecessary. It also represents a transition, a humbling experience that will allow you to reach new heights."
  },
  "1076064": {
    "ENU": "The Tower is the release, the sudden upheaval. You may experience a crisis, or a breakthrough. It is often humbling, toppling from the heights of ones ego, but can be a revelation as well."
  },
  "1076065": {
    "ENU": "The Star represents inspiration, renewed hope for the future. It is the light at the end of the tunnel. The Star can be generous, opening the heart to give to others, with such actions bringing peace and serenity.",
    "PTB": "A Estrela representa inspiração, renovada esperança para o futuro. É a luz no fim do túnel. A Estrela pode ser generosa, abrindo o coração para dar aos outros, com tais ações trazendo paz e serenidade."
  },
  "1076066": {
    "ENU": "The World is fulfillment, the state of accomplishment, the realization of your goals. Your experiences combining into your whole self. This is when your dreams come true.",
    "PTB": "O Mundo é realização, o estado de conquista, a concretização de seus objetivos. Suas experiências se combinando em seu eu completo. É quando seus sonhos se tornam realidade."
  },
  "1076067": {
    "ENU": "lords",
    "PTB": "lordes"
  },
  "1076068": {
    "ENU": "ladies",
    "PTB": "senhoras"
  },
  "1076069": {
    "ENU": "Lord",
    "PTB": "Lorde"
  },
  "1076070": {
    "ENU": "Lady",
    "PTB": "Senhora"
  },
  "1076071": {
    "ENU": "~1_NAME~ rolls ~2_DICE~d~3_FACES~: ~4_ROLLS~ (Total: ~5_TOTAL~)",
    "PTB": "~1_NAME~ rola ~2_DICE~d~3_FACES~: ~4_ROLLS~ (Total: ~5_TOTAL~)"
  },
  "1076072": {
    "ENU": "~1_TITLE~ ~2_NAME~ has arrived! Let the drinks flow! Let the festivites commence! And you there, with the pig, get that beast on a skewer!",
    "PTB": "~1_TITLE~ ~2_NAME~ chegou! Que as bebidas corram! Que as festividades comecem! E você aí, com o porco, coloque essa besta no espeto!"
  },
  "1076073": {
    "ENU": "Let the ~1_SAME_SEX~ cower and the ~2_OPPOSITE_SEX~ swoon, for now approaches the ~3_TITLE~ ~4_NAME~.",
    "PTB": "Que os ~1_SAME_SEX~ tremam e os ~2_OPPOSITE_SEX~ se derritam, pois se aproxima o ~3_TITLE~ ~4_NAME~."
  },
  "1076074": {
    "ENU": "Welcome to this humble marketplace. If you need any assistance ~1_OWNER_TITLE~ ~2_OWNER_NAME~ will be glad to help you.",
    "PTB": "Bem-vindo a este humilde mercado. Se precisar de qualquer ajuda, ~1_OWNER_TITLE~ ~2_OWNER_NAME~ terá prazer em ajudar."
  },
  "1076075": {
    "ENU": "Come Friend! Enter ~1_OWNER_TITLE~ ~2_OWNER_NAME~'s wondrous shop of many things! If you can't find it here, I suggest you go somewhere else!",
    "PTB": "Venha, Amigo! Entre na maravilhosa loja de muitas coisas de ~1_OWNER_TITLE~ ~2_OWNER_NAME~! Se não encontrar algo aqui, sugiro que vá a outro lugar!"
  },
  "1076076": {
    "ENU": "*Looks ~1_VISITOR_NAME~ over with narrowed eyes, scowling, and points to the sign on the wall* \"Reagents for spell casting only, Please do not eat!\""
  },
