  },
  "1007101": {
    "ENU": "Hail and well met!",
    "PTB": "Saudações e bem-vindo!"
  },
  "1007102": {
    "ENU": "Greetings, fellow guard.",
    "PTB": "Saudações, companheiro guarda."
  },
  "1007103": {
    "ENU": "In the name of our liege, greetings!",
    "PTB": "Em nome do nosso líder, saudações!"
  },
  "1007104": {
    "ENU": "Greetings, my friend.",
    "PTB": "Saudações, meu amigo."
  },
  "1007105": {
    "ENU": "Hail, my friend.",
    "PTB": "Salve, meu amigo."
  },
  "1007106": {
    "ENU": "Yes, thou'rt a virtue guard.",
    "PTB": "Sim, és um guarda de virtude."
  },
  "1007107": {
    "ENU": "Hmm? Yes, I am one. So art thou.",
    "PTB": "Hmm? Sim, sou um. E tu também és."
  },
  "1007108": {
    "ENU": "Yes, as thou knowest, it is a great thing to be one!",
    "PTB": "Sim, como sabes, é uma grande coisa ser um!"
  },
  "1007109": {
    "ENU": "Isn't it wonderful being a virtue guard?",
    "PTB": "Não é maravilhoso ser um guarda de virtude?"
  },
  "1007110": {
    "ENU": "Why dost thou ask about virtue guards when thou art one?",
    "PTB": "Por que perguntas sobre guardas de virtude quando és um?"
  },
  "1007111": {
    "ENU": "Stay away, lest our rivalry develop into something worse!",
    "PTB": "Fique longe, para que nossa rivalidade não se desenvolva em algo pior!"
  },
  "1007112": {
    "ENU": "Thou'rt not of my brotherhood! Away with thee!",
    "PTB": "Não és da minha irmandade! Fora daqui!"
  },
  "1007113": {
    "ENU": "Whilst I grant respect to thy lord, I mislike thy emblem.",
    "PTB": "Embora eu conceda respeito ao teu senhor, não gosto do teu emblema."
  },
  "1007114": {
    "ENU": "Art thou here to harass me?",
    "PTB": "Vieste me provocar?"
  },
  "1007115": {
    "ENU": "Tch tch... thou wearest the wrong emblem!",
    "PTB": "Tch tch... você usa o emblema errado!"
  },
  "1007116": {
    "ENU": "'Tis a pity that thou art in the wrong camp!",
    "PTB": "É uma pena que estejas no grupo errado!"
  },
  "1007117": {
    "ENU": "There is a rivalry between thy group and mine--be careful.",
    "PTB": "Há uma rivalidade entre teu grupo e o meu - tenha cuidado."
  },
  "1007118": {
    "ENU": "Is not thy emblem a sign that thou art a member of our rival guards?",
    "PTB": "Não é o teu emblema um sinal de que és membro dos nossos guardas rivais?"
  },
  "1007119": {
    "ENU": "Thou art not worthy of being a member of our fraternity.",
    "PTB": "Não és digno de ser membro da nossa fraternidade."
  },
  "1007120": {
    "ENU": "The guards will not accept thee until thy reputation improves.",
    "PTB": "Os guardas não te aceitarão até que tua reputação melhore."
  },
  "1007121": {
    "ENU": "Thou hast not the unblemished record we expect from our members.",
    "PTB": "Não tens o registro imaculado que esperamos de nossos membros."
  },
  "1007122": {
    "ENU": "Thy record is not good enough to join the guards.",
    "PTB": "Teu registro não é bom o suficiente para entrar nos guardas."
  },
  "1007123": {
    "ENU": "Only those of utmost probity are accepted into the guards.",
    "PTB": "Apenas aqueles de máxima probidade são aceitos nos guardas."
  },
  "1007124": {
    "ENU": "Only the very best of citizens may join the guards.",
    "PTB": "Apenas os melhores cidadãos podem entrar nos guardas."
  },
  "1007125": {
    "ENU": "Thou dost not qualify for the virtue guards; thy record is not good enough.",
    "PTB": "Não te qualificas para os guardas de virtude; teu registro não é bom o suficiente."
  },
  "1007126": {
    "ENU": " Thou'rt extremely close, however.",
    "PTB": "Estás extremamente próximo, no entanto."
  },
  "1007127": {
    "ENU": " Do not dishonor us by asking again, scum.",
    "PTB": "Não nos desonre pedindo novamente, escória."
  },
  "1007128": {
    "ENU": "Thou hast the look of a likely candidate for joining Lord Blackthorn's guards.",
    "PTB": "Tens a aparência de um candidato em potencial para entrar nos guardas de Lord Blackthorn."
  },
  "1007129": {
    "ENU": "Wouldst thou be interested in joining Blackthorn's guard?",
    "PTB": "Gostarias de se juntar aos guardas de Blackthorn?"
  },
  "1007130": {
    "ENU": "Blackthorn's guard hath been looking for folk like thee.",
    "PTB": "Os guardas de Blackthorn têm procurado pessoas como tu."
  },
  "1007131": {
    "ENU": "Thou'rt a good and honest person. Care to join Lord Blackthorn's guard?",
    "PTB": "És uma boa e honesta pessoa. Quer se juntar aos guardas de Lord Blackthorn?"
  },
  "1007132": {
    "ENU": "If thou art interested in joining Lord Blackthorn's guard, a place can be found for thee.",
    "PTB": "Se estás interessado em entrar nos guardas de Lord Blackthorn, podemos encontrar um lugar para ti."
  },
  "1007133": {
    "ENU": "Say 'yea' if thou art interested.",
    "PTB": "Diz 'sim' se estiveres interessado."
  },
  "1007134": {
    "ENU": "Thou hast the look of a likely candidate for joining Lord British's guards.",
    "PTB": "Tens a aparência de um candidato em potencial para entrar nos guardas de Lord British."
  },
  "1007135": {
    "ENU": "Wouldst thou be interested in joining British's guard?",
    "PTB": "Gostarias de se juntar aos guardas de British?"
  },
  "1007136": {
    "ENU": "British's guard hath been looking for folk like thee.",
    "PTB": "Os guardas de British têm procurado pessoas como tu."
  },
  "1007137": {
    "ENU": "Thou'rt a good and honest person. Care to join Lord British's guard?",
    "PTB": "És uma boa e honesta pessoa. Quer se juntar aos guardas de Lord British?"
  },
  "1007138": {
    "ENU": "If thou art interested in joining Lord British's guard, a place can be found for thee.",
    "PTB": "Se estás interessado em entrar nos guardas de Lord British, podemos encontrar um lugar para ti."
  },
  "1007139": {
    "ENU": "I see you are in need of our shield, Here you go.",
    "PTB": "Vejo que precisas do nosso escudo, aqui está."
  },
  "1007140": {
    "ENU": "Sign up with a guild of chaos if thou art interested.",
    "PTB": "Inscreva-se em uma guilda do caos se estiveres interessado."
  },
  "1007141": {
    "ENU": "Sign up with a guild of order if thou art interested.",
    "PTB": "Inscreva-se em uma guilda da ordem se estiveres interessado."
  },
  "1007142": {
    "ENU": "Excellent! Welcome to our ranks!",
    "PTB": "Excelente! Bem-vindo às nossas fileiras!"
  },
  "1007143": {
    "ENU": "Welcome to our ranks!",
    "PTB": "Bem-vindo às nossas fileiras!"
  },
  "1007144": {
    "ENU": "Excellent!",
    "PTB": "Excelente!"
  },
  "1007145": {
    "ENU": "'Tis a good choice.",
    "PTB": "É uma boa escolha."
  },
  "1007146": {
    "ENU": "Congratulations!",
    "PTB": "Parabéns!"
  },
  "1007147": {
    "ENU": "I congratulate thee!",
    "PTB": "Congratulo-te!"
  },
  "1007148": {
    "ENU": "Thy shield is in thy backpack. Be sure thou dost not lose thy reputation, or else thou shalt lose thy life with it.",
    "PTB": "Teu escudo está em tua mochila. Certifica-te de não perderes tua reputação, ou perderás tua vida junto com ela."
  },
  "1007149": {
    "ENU": "Ho ho ho!",
    "PTB": "Ho ho ho!"
  },
  "1007150": {
    "ENU": "Happy Holidays!",
    "PTB": "Feliz Feriados!"
  },
  "1007151": {
    "ENU": "A merry season to thee!",
    "PTB": "Uma estação alegre para ti!"
  },
  "1007152": {
    "ENU": "Enjoy the holidays!",
    "PTB": "Aproveite os feriados!"
  },
  "1007153": {
    "ENU": "Ho ho ho! Happy holidays!",
    "PTB": "Ho ho ho! Feliz Feriados!"
  },
  "1007154": {
    "ENU": "May the holidays be joyful!",
    "PTB": "Que os feriados sejam alegres!"
  },
  "1007155": {
    "ENU": "Enjoy the season!",
    "PTB": "Aproveite a estação!"
  },
  "1007156": {
    "ENU": "I wish thee the joy of the season!",
    "PTB": "Desejo-te a alegria da estação!"
  },
  "1007157": {
    "ENU": "I wish thee joy! Ho ho ho!",
    "PTB": "Desejo-te alegria! Ho ho ho!"
  },
  "1007158": {
    "ENU": "Naughty or nice? Hmm.",
    "PTB": "Travesso ou comportado? Hmm."
  },
  "1007159": {
    "ENU": "Where IS Rudolph? He's never this late.",
    "PTB": "Onde ESTÁ o Rudolph? Ele nunca se atrasa assim."
  },
  "1007160": {
    "ENU": "Dancer, Prancer, don't wander off.",
    "PTB": "Dancer, Prancer, não se afastem."
  },
  "1007161": {
    "ENU": "If I only had a sleigh...",
    "PTB": "Se eu ao menos tivesse um trenó..."
  },
  "1007162": {
    "ENU": "I think I'm going to cause a worldwide shortage of coal this year.",
    "PTB": "Acho que vou causar uma escassez mundial de carvão este ano."
  },
  "1007163": {
    "ENU": "British? Coal or a fruitcake? Hmm.",
    "PTB": "British? Carvão ou bolo de frutas? Hmm."
  },
  "1007164": {
    "ENU": "Hmm, coal, or a fruitcake for Blackthorn?",
    "PTB": "Hmm, carvão ou bolo de frutas para Blackthorn?"
  },
  "1007165": {
    "ENU": "Hmm, I seem to have lost some weight.",
    "PTB": "Hmm, parece que perdi alguns quilos."
  },
  "1007166": {
    "ENU": "'Tis a noble gift.",
    "PTB": "É um presente nobre."
  },
  "1007167": {
    "ENU": "Money is always welcome.",
    "PTB": "Dinheiro é sempre bem-vindo."
  },
  "1007168": {
    "ENU": "Fish feet and bird lips! We've sprung a leak! Start bailin'!",
    "PTB": "Pés de peixe e lábios de pássaro! Estamos vazando! Comecem a despejar!"
  },
  "1007169": {
    "ENU": "Ar! So this be how it ends, eh? Blasted land lubbers leavin' me to drown!",
    "PTB": "Ar! Então é assim que termina, hein? Malditos terrestres me deixando afogar!"
  },
  "1007170": {
    "ENU": "None there are to save this ship.",
    "PTB": "Não há ninguém para salvar este navio."
  },
  "1007171": {
    "ENU": "Bloody bucket ne'er had a name.",
    "PTB": "Balde maldito nunca teve um nome."
  },
  "1007172": {
    "ENU": "I be comin' home 'Lizabeth! This is the big one!",
    "PTB": "Estou voltando para casa, Elizabeth! Esta é a grande!"
  },
  "1008000": {
    "ENU": "For the deed I have placed gold in your bankbox : "
  },
  "1008001": {
    "ENU": "I will pay you gold for this deed : "
  },
  "1008002": {
    "ENU": "Here have some coins : "
  },
  "1008003": {
    "ENU": "Thou'rt wanted!"
  },
  "1008004": {
    "ENU": "Flee now before I behead thee, scum!"
  },
  "1008005": {
    "ENU": "How nice of thee to come to meet my blade."
  },
  "1008006": {
    "ENU": "Stand back, everyone, a dastardly criminal approaches."
  },
  "1008007": {
    "ENU": "Now, I shall kill thee."
  },
  "1008008": {
    "ENU": "A warrant is outstanding for thy execution."
  },
  "1008009": {
    "ENU": "Thou hast made a fatal mistake by showing thy filthy face."
  },
  "1008010": {
    "ENU": "'Twill be a pleasure to dispatch a scoundrel such as thee."
  },
  "1008011": {
    "ENU": "Beware, all, whilst I dispose of this evildoer."
  },
  "1008012": {
    "ENU": "'Tis a shame that thou canst not reform, for now I shall have to kill thee."
  },
  "1008013": {
    "ENU": "Thy sort is not welcome here. Thou hadst best run now."
  },
  "1008014": {
    "ENU": "Get out of our city, scum!"
  },
  "1008015": {
    "ENU": "Don't do anything foolish."
  },
  "1008016": {
    "ENU": "We'll be keeping an eye on thee."
  },
  "1008017": {
    "ENU": "I know thy type. Break not the laws, or else suffer punishment!"
  },
  "1008018": {
    "ENU": "Thou hast a suspicious look about thee."
  },
  "1008019": {
    "ENU": "I trust thee not, nor should anyone. Thou art a ruffian."
  },
  "1008020": {
    "ENU": "Faugh, another scoundrel to keep an eye on!"
  },
  "1008021": {
    "ENU": "I have heard of thee--keep thee to the straight and narrow whilest here!"
  },
  "1008022": {
    "ENU": "If I catch thee breaking laws, thy neck will be on the line."
  },
  "1008023": {
    "ENU": "Thou hast an unsavory reputation--best that thou dost not prove that thou earnst it."
  },
  "1008024": {
    "ENU": "Thou art known as a criminal. Do not draw the attention of the guards with thy deeds, or risk death!"
  },
  "1008025": {
    "ENU": "Mine eye is on thee, scoundrel. Break not the law."
  },
  "1008026": {
    "ENU": "Thou art a scofflaw, but while here thou SHALT obey the laws, or suffer."
  },
  "1008027": {
    "ENU": "Look thee who crawled out from under a rock! Well, thou shalt not do anything illegal whilst I am watching thee!"
  },
  "1008028": {
    "ENU": "The guards well know thee and thy nefarious ways! be sure to behave thyself!"
  },
  "1008029": {
    "ENU": "Scum! Stay not overlong here, for thou art not welcome!"
  },
  "1008030": {
    "ENU": "I hope that thou art merely visiting, for we mislike knaves mingling with our citizens."
  },
  "1008031": {
    "ENU": "Thou shouldst leave this city before any decide to lynch thee."
  },
  "1008032": {
    "ENU": "I should arrest thee now, before thou dost something terrible. Thou art well known as a rogue of the worst kind."
  },
  "1008033": {
    "ENU": "Thy foes ye meet, no doubt ye should harm."
  },
  "1008034": {
    "ENU": "Thy traps ye find, ye shall defeat."
  },
  "1008035": {
    "ENU": "The treasures within, should become part of thee."
  },
  "1008036": {
    "ENU": "Thou hast thy bravery at least."
  },
  "1008037": {
    "ENU": "Your reputation doth proceed thee."
  },
  "1008038": {
    "ENU": "I know not of you, your fate is shrouded in mystery."
  },
  "1008039": {
    "ENU": "Foul beasts within, whom ye may find good company."
  },
  "1008040": {
    "ENU": "The shimmering clouds have revealed a dark destiny, one wrought with peril."
  },
  "1008041": {
    "ENU": "The cloudy mist of the all-seeing eye have revealed a path filled with still waters."
  },
  "1008042": {
    "ENU": "The clouds of time reveal the ghosts of the past, still priesting over their congregation."
  },
  "1008043": {
    "ENU": "Ye shant not fail, have you the eye of an eagle, the strength of an ox and the nimbleness of a wolverine."
  },
  "1008044": {
    "ENU": "The clouds have reveal a philosopher, a priest and three thousand leagues of skeletons marching row by row."
  },
  "1008045": {
    "ENU": "The halls of fate, the halls of doom, in wells of thought, one might find room."
  },
  "1008046": {
    "ENU": "Ghastly shadows on forlorn walls, echo the death of foes and falls."
  },
  "1008047": {
    "ENU": "Beware ye who pass this way, for darkness works in mysterious ways."
  },
  "1008048": {
    "ENU": "On bended knee they came and slew, ten thousand souls for the freedom of Yew."
  },
  "1008049": {
    "ENU": "Brave hearts dive in and yet not return, their fate swallowed by the fires that burn."
  },
  "1008050": {
    "ENU": "Once a treasure was laid at the bottom of the tomb, in darkness and light, its wealth did bloom."
  },
  "1008051": {
    "ENU": "Cast not one eye to the flames' disguise, for marching in order are invisible eyes."
  },
  "1008052": {
    "ENU": "There is a fee in gold coins for joining the guild : "
  },
  "1008053": {
    "ENU": "Welcome to the guild! Stay to the shadows, friend."
  },
  "1008054": {
    "ENU": "Welcome to the guild! Thou shalt find that fellow members shall grant thee lower prices in shops."
  },
