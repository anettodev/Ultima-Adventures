  "1080492": {
    "ENU": "You are reluctant to disturb the evidence without cause."
  },
  "1080493": {
    "ENU": "The victim was killed with an extremely sharp object. There seems to be a document folded in his pocket."
  },
  "1080494": {
    "ENU": "The victim was killed with something sharper than a normal sword."
  },
  "1080495": {
    "ENU": "You carefully remove the parchment from the corpse. It is soaked in blood and illegible."
  },
  "1080496": {
    "ENU": "A token of our respect to the Shadows. For the eternal glory of nothingness! - FOA"
  },
  "1080497": {
    "ENU": "You have given me enough of that already."
  },
  "1080498": {
    "ENU": "Alright, I've thinned the blood. I suggest you see Althara next."
