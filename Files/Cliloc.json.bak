  "1075102": {
    "ENU": "Muahahahaha!  I'll feast on your flesh."
  },
  "1075103": {
    "ENU": "Mmmm, your bones look extra crunchy."
  },
  "1075104": {
    "ENU": "Teeeheeeee!  Teeeheeee!  You think you can defeat me?"
  },
  "1075105": {
    "ENU": "Oh!  You're a handsome one.  I may just have to keep you."
  },
  "1075106": {
    "ENU": "Fools!  You cannot defeat me."
  },
  "1075107": {
    "ENU": "Do you think I'm pretty?  Muahahahaha!  Give us a kiss."
  },
  "1075108": {
    "ENU": "Snap! Pop! Crack! The lovely sounds of your tearing flesh. Muahahahaha!"
  },
  "1075109": {
    "ENU": "Well, don't you look like tasty morsel!  Mmmm, I love home delivery."
  },
  "1075110": {
    "ENU": "I'm going to feast on your brains!"
  },
  "1075111": {
    "ENU": "Teeeheee!  You've made a big mistake, dearie."
  },
  "1075112": {
    "ENU": "I'm so glad you're here.  I was running out of fresh meat."
  },
  "1075113": {
    "ENU": "If you really impress me, I might just keep you as a pet for a while.  Would you like that?"
  },
  "1075114": {
    "ENU": "You made a mistake ... now you're all out on a limb.  Muahahahahaha."
  },
  "1075115": {
    "ENU": "Oooh!  I've had enough of your meddling."
  },
  "1075116": {
    "ENU": "A twisted satyr scrambles onto the branch beside you and attacks!"
  },
  "1075117": {
    "ENU": "Muahahaha!  Your life essence is MINE!"
  },
  "1075118": {
    "ENU": "Noooooo!  You shall never defeat me.  Even if I should fall, my tree will sustain me and I will rise again."
  },
  "1075119": {
    "ENU": "Awake my children!  I summon thee!"
  },
  "1075120": {
    "ENU": "An unholy aura surrounds Lady Melisande as her wounds begin to close."
  },
  "1075121": {
    "ENU": "You shall pay for your insolence!  My delaying tactic has worked and my brethren are alerted to your presence.  Trifle with the Black Order at your own peril."
  },
  "1075122": {
    "ENU": "In the confusion, Travesty vanishes from sight."
  },
