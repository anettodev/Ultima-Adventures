  "1076664": {
    "ENU": "<B>Ultima Online Rewards Program</B><BR>Thank you for being part of the Ultima Online community for over 6 months. As a token of our appreciation, your stat cap will be increased. "
  },
  "1076665": {
    "ENU": "You may not start a new transfer now because you already have another character transfer in progress.  Please wait until your previous transfer completes before starting a new transfer."
