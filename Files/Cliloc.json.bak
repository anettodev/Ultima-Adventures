  "1013035": {
    "ENU": "Thou'rt not welcome as a customer here. I shall charge thee a premium above my normal price."
  },
  "1013036": {
    "ENU": "Tis an honor to have thee as a patron. Please accept a discount on my wares!"
  },
  "1013037": {
    "ENU": "Thou'rt scum! Guards!"
  },
  "1013038": {
    "ENU": "Guards! A villain!"
  },
  "1013039": {
    "ENU": "Tis a villain! Guards!"
  },
  "1013040": {
    "ENU": "Guards! help!"
  },
  "1013041": {
    "ENU": "Help! Guards! Flood, fire, famine!"
  },
  "1013042": {
    "ENU": "Aaaah! They will kill me! Guards!"
  },
  "1013043": {
    "ENU": "Arrest this scum!"
  },
  "1013044": {
    "ENU": "Look! Tis that evil one! Guards!"
  },
  "1013045": {
    "ENU": "Beware! 'Tis that scoundrel! Guards!"
  },
  "1013046": {
    "ENU": "Look thee, a criminal! Guards!"
  },
  "1013047": {
    "ENU": "Thy like is not welcome here! Guards! arrest this person!"
  },
  "1013048": {
    "ENU": "Scum like thee is not welcome here. Guards!"
  },
  "1013049": {
    "ENU": "To think I saw thee and lived! Guards!"
  },
  "1013050": {
    "ENU": "We tolerate not those like thee! Guards!"
  },
  "1013051": {
    "ENU": "Get out of here, scum! Guards!"
  },
  "1013052": {
    "ENU": "Guards! Guards!"
  },
