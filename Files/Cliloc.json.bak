  },
  "1095135": {
    "ENU": "Floor trap kits"
  },
  "1095136": {
    "ENU": "You apply the balm and suddenly feel stronger!"
  },
  "1095137": {
    "ENU": "You apply the balm and suddenly feel wiser!"
  },
  "1095138": {
    "ENU": "You apply the balm and suddenly feel more agile!"
  },
  "1095139": {
    "ENU": "Flint wasn't kidding. This brew is strong!"
  },
  "1095140": {
    "ENU": "Whew! Someone nearby has drank some strong beer! You feel light headed."
  },
  "1095141": {
    "ENU": "You feel sober, but you sure do stink!"
  },
  "1095142": {
    "ENU": "You no longer stink from Flint's Pungent Brew."
  },
  "1095143": {
    "ENU": "You apply the ointment and suddenly feel less vulnerable!"
  },
  "1095144": {
    "ENU": "Applying this will replace the effects currently active. Do you wish to proceed?"
  },
  "1095145": {
    "ENU": "Replace active balm or lotion"
  },
  "1095146": {
    "ENU": "As the rotworm dies, you find and pickup a scroll case. Inside the scroll case is parchment. The scroll case crumbles to dust."
