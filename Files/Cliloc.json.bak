  "1049143": {
    "ENU": "This is the corpse of a wizard's apprentice.  You can't bring yourself to search it without a good reason."
  },
  "1049144": {
    "ENU": "the remains of ~1_NAME~ the apprentice"
  },
  "1049145": {
