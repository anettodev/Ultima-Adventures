    "ENU": "Storage"
  },
  "1060237": {
    "ENU": "Lockdowns"
  },
  "1060238": {
    "ENU": "Thank you for your feedback!"
  },
  "1060239": {
    "ENU": "<CENTER>CONSTRUCTION CONTRACT</CENTER>"
  },
  "1060240": {
    "ENU": "You must have at least 500 tithing points before you can continue in your quest."
  },
