  "1052000": {
    "ENU": "You're resurrections through Sacrifice have been reset.",
    "PTB": "Suas ressurreições através do Sacrifício foram redefinidas."
  },
  "1052001": {
    "ENU": "You're corpse cannot be found.  It may have decayed or it may be on a different sub-server. If you choose to resurrect now you will not have any items returned to you. Do you wish to resurrect now?",
    "PTB": "Seu corpo não pode ser encontrado. Pode ter decaído ou estar em um sub-servidor diferente. Se você optar por ressuscitar agora, não terá nenhum item devolvido. Deseja ressuscitar agora?"
  },
  "1052002": {
    "ENU": "Yes.",
    "PTB": "Sim."
  },
  "1052003": {
    "ENU": "No.",
    "PTB": "Não."
  },
  "1052004": {
    "ENU": "You cannot use this ability.",
    "PTB": "Você não pode usar esta habilidade."
  },
  "1052005": {
    "ENU": "You do not have any resurrections left.",
    "PTB": "Você não tem mais ressurreições."
  },
  "1052006": {
    "ENU": "You cannot use this ability in a house, on a boat, or in a faction stronghold.",
    "PTB": "Você não pode usar esta habilidade em uma casa, em um barco ou em uma fortaleza de facção."
  },
  "1052007": {
    "ENU": "You cannot use this ability while flagged as a criminal.",
    "PTB": "Você não pode usar esta habilidade enquanto estiver sinalizado como criminoso."
  },
  "1052008": {
    "ENU": "You have gained a path in Sacrifice!",
    "PTB": "Você ganhou um caminho no Sacrifício!"
  },
  "1052009": {
    "ENU": "I have seen the error of my ways!",
    "PTB": "Percebi o erro dos meus caminhos!"
  },
  "1052010": {
    "ENU": "You have set the creature free.",
    "PTB": "Você libertou a criatura."
  },
  "1052011": {
    "ENU": "You must have line of sight to do that.",
    "PTB": "Você deve ter linha de visão para fazer isso."
  },
  "1052012": {
    "ENU": "You have attained the highest path in this virtue.",
    "PTB": "Você atingiu o caminho mais alto desta virtude."
  },
  "1052013": {
    "ENU": "You cannot sacrifice for this monster because it is too damaged.",
    "PTB": "Você não pode sacrificar esta criatura porque está muito danificada."
  },
  "1052014": {
    "ENU": "You cannot sacrifice your fame for that creature.",
    "PTB": "Você não pode sacrificar sua fama para essa criatura."
  },
  "1052015": {
    "ENU": "You cannot do that while hidden.",
    "PTB": "Você não pode fazer isso enquanto estiver escondido."
  },
  "1052016": {
    "ENU": "You must wait approximately one day before sacrificing again.",
    "PTB": "Você deve esperar aproximadamente um dia antes de sacrificar novamente."
  },
  "1052017": {
    "ENU": "You do not have enough fame to sacrifice.",
    "PTB": "Você não tem fama suficiente para sacrificar."
  },
  "1052018": {
    "ENU": "The young player has declined your invitation.",
    "PTB": "O jogador jovem recusou seu convite."
  },
  "1052019": {
    "ENU": "The young player has accepted your invitation.",
    "PTB": "O jogador jovem aceitou seu convite."
  },
  "1052020": {
    "ENU": "That player is already your squire.",
    "PTB": "Aquele jogador já é seu escudeiro."
  },
  "1052021": {
    "ENU": "You have already helped a character from that account.",
    "PTB": "Você já ajudou um personagem dessa conta."
  },
  "1052022": {
    "ENU": "Squire",
    "PTB": "Escudeiro"
  },
  "1052023": {
    "ENU": "You have decided to no longer be a squire, or your sponsor has either released you as a squire or has logged off from the game.  Would you like to return to Haven?",
    "PTB": "Você decidiu não ser mais um escudeiro, ou seu patrocinador o liberou como escudeiro ou saiu do jogo. Gostaria de retornar a Haven?"
  },
  "1052024": {
    "ENU": "You have been asked to be a squire by a veteran player.  Veteran players who take on a squire can gain benefits while you gain skills. Be sure that you have talked with this player before accepting their invitation to make sure they are willing to answer your other game related questions as well.",
    "PTB": "Você foi convidado para ser escudeiro por um jogador veterano. Jogadores veteranos que aceitam um escudeiro podem ganhar benefícios enquanto você ganha habilidades. Certifique-se de que conversou com este jogador antes de aceitar o convite para garantir que esteja disposto a responder suas outras perguntas relacionadas ao jogo."
  },
  "1052025": {
    "ENU": "You have been asked by:",
    "PTB": "Você foi convidado por:"
  },
  "1052026": {
    "ENU": "Yes, I would like to be a squire to this player.",
    "PTB": "Sim, gostaria de ser escudeiro deste jogador."
  },
  "1052027": {
    "ENU": "No, I do not wish to be a squire to this player.",
    "PTB": "Não, não desejo ser escudeiro deste jogador."
  },
  "1052028": {
    "ENU": "No, I do not wish to be available to be a squire for the remainder of my time online.",
    "PTB": "Não, não desejo estar disponível para ser escudeiro pelo resto do meu tempo online."
  },
  "1052029": {
    "ENU": "You have been asked to be a squire by a veteran player. Would you like to learn more?",
    "PTB": "Você foi convidado para ser escudeiro por um jogador veterano. Gostaria de saber mais?"
  },
  "1052030": {
    "ENU": "That player is not eligible to be a squire at this time.",
    "PTB": "Aquele jogador não é elegível para ser escudeiro no momento."
  },
  "1052031": {
    "ENU": "Select the young player you wish to invite to be your squire.",
    "PTB": "Selecione o jogador jovem que deseja convidar para ser seu escudeiro."
  },
  "1052032": {
    "ENU": "Target yourself to break the tie with your current squire.",
    "PTB": "Mire em si mesmo para romper o vínculo com seu escudeiro atual."
  },
  "1052033": {
    "ENU": "Squire Feedback",
    "PTB": "Feedback do Escudeiro"
  },
  "1052034": {
    "ENU": "You have been a squire to another player.  Please take a moment to rate your experience as a squire.",
    "PTB": "Você foi escudeiro de outro jogador. Por favor, reserve um momento para avaliar sua experiência como escudeiro."
  },
  "1052035": {
    "ENU": "I benefited a great deal from being a squire.",
    "PTB": "Beneficiei-me muito por ser escudeiro."
  },
  "1052036": {
    "ENU": "I got some benefit from being a squire.",
    "PTB": "Obtive algum benefício por ser escudeiro."
  },
  "1052037": {
    "ENU": "I benefited very little from being a squire.",
    "PTB": "Beneficiei-me muito pouco por ser escudeiro."
  },
  "1052038": {
    "ENU": "Being a squire hurt my experience in UO.",
    "PTB": "Ser escudeiro prejudicou minha experiência em UO."
  },
  "1052039": {
    "ENU": "I am not new to UO. This is a second account.",
    "PTB": "Não sou novo em UO. Esta é uma segunda conta."
  },
  "1052040": {
    "ENU": "You have lost some Humility.",
    "PTB": "Você perdeu um pouco de Humildade."
  },
  "1052041": {
    "ENU": "You have lost some Sacrifice.",
    "PTB": "Você perdeu um pouco de Sacrifício."
  },
  "1052042": {
    "ENU": "Your squire has left the game.  You are no longer a sponsor to that character.",
    "PTB": "Seu escudeiro saiu do jogo. Você não é mais patrocinador daquele personagem."
  },
  "1052043": {
    "ENU": "You are no longer a squire.",
    "PTB": "Você não é mais um escudeiro."
  },
  "1052044": {
    "ENU": "You have not started on the path of this Virtue.",
    "PTB": "Você não começou no caminho desta Virtude."
  },
  "1052045": {
    "ENU": "You have barely begun your journey through the path of this Virtue.",
    "PTB": "Você mal começou sua jornada através do caminho desta Virtude."
  },
  "1052046": {
    "ENU": "You have progressed in this Virtue, but still have much to do.",
    "PTB": "Você progrediu nesta Virtude, mas ainda tem muito a fazer."
  },
  "1052047": {
    "ENU": "Your journey through the path of this Virtue is going well.",
    "PTB": "Sua jornada através do caminho desta Virtude está indo bem."
  },
  "1052048": {
    "ENU": "You feel very close to achieving your next path in this Virtue.",
    "PTB": "Você se sente muito próximo de alcançar seu próximo caminho nesta Virtude."
  },
  "1052049": {
    "ENU": "You have achieved a path in this Virtue.",
    "PTB": "Você alcançou um caminho nesta Virtude."
  },
  "1052050": {
    "ENU": "You have achieved the highest path in this Virtue.",
    "PTB": "Você alcançou o caminho mais alto nesta Virtude."
  },
  "1052051": {
    "ENU": "Humility is perceiving one's place in the world, not according to one's own accomplishments, but according to the intrinsic value of all individuals. One gains Humility through helping young players.",
    "PTB": "Humildade é perceber o próprio lugar no mundo, não de acordo com as próprias conquistas, mas de acordo com o valor intrínseco de todos os indivíduos. Ganha-se Humildade ajudando jogadores jovens."
  },
  "1052052": {
    "ENU": "-click to learn more (opens webpage)",
    "PTB": "-clique para saber mais (abre página da web)"
  },
  "1052053": {
    "ENU": "Sacrifice is the courage to give of oneself in the name of love. One gains in Sacrifice by giving away their fame to certain monsters to save them from their eternal torment.",
    "PTB": "Sacrifício é a coragem de se dar em nome do amor. Ganha-se Sacrifício doando sua fama para certas criaturas para salvá-las de seu tormento eterno."
  },
  "1052054": {
    "ENU": "Compassion is nonjudgmental empathy for one's fellow creatures.",
    "PTB": "Compaixão é a empatia não-julgadora para com as outras criaturas."
  },
  "1052055": {
    "ENU": "This virtue is not yet defined.",
    "PTB": "Esta virtude ainda não está definida."
  },
  "1052056": {
    "ENU": "Spirituality is the concern with one's inner being and how one deals with truth, love, and courage.",
    "PTB": "Espiritualidade é a preocupação com o próprio ser interior e como se lida com verdade, amor e coragem."
  },
  "1052057": {
    "ENU": "Valor is the courage to take actions in support of one's convictions.",
    "PTB": "Valor é a coragem de tomar ações em apoio às próprias convicções."
  },
  "1052058": {
    "ENU": "Honor is the courage to stand for truth, against any odds.",
    "PTB": "Honra é a coragem de defender a verdade, contra qualquer obstáculo."
  },
  "1052059": {
    "ENU": "Justice is the devotion to truth, tempered by love.",
    "PTB": "Justiça é a devoção à verdade, temperada pelo amor."
  },
  "1052060": {
    "ENU": "Honesty is the scrupulous respect for truth, the willingness to never deceive oneself or another.",
    "PTB": "Honestidade é o respeito escrupuloso pela verdade, a disposição de nunca enganar a si mesmo ou a outro."
  },
  "1052061": {
    "ENU": "Close",
    "PTB": "Fechar"
  },
  "1052062": {
    "ENU": "Click on a blue gem to view your status in that virtue.",
    "PTB": "Clique em uma gema azul para ver seu status naquela virtude."
  },
  "1052063": {
    "ENU": "You must wait before asking another player to be your squire.",
    "PTB": "Você deve esperar antes de pedir a outro jogador para ser seu escudeiro."
  },
  "1052064": {
    "ENU": "You cannot use this virtue while you are a young player.",
    "PTB": "Você não pode usar esta virtude enquanto for um jogador jovem."
  },
  "1052065": {
    "ENU": "You cannot ask young players to be your squire while in Uzerann's mansion.",
    "PTB": "Você não pode pedir escudeiros jovens enquanto estiver na mansão de Uzerann."
  },
  "1052066": {
    "ENU": "That virtue is not active yet.",
    "PTB": "Aquela virtude ainda não está ativa."
  },
  "1052067": {
    "ENU": "That is not a young player.",
    "PTB": "Aquele não é um jogador jovem."
  },
  "1052068": {
    "ENU": "You have already attained the highest path in this virtue.",
    "PTB": "Você já atingiu o caminho mais alto nesta virtude."
  },
  "1052069": {
    "ENU": "You no longer have a squire.",
    "PTB": "Você não tem mais um escudeiro."
  },
  "1052070": {
    "ENU": "You have gained in Humility.",
    "PTB": "Você ganhou em Humildade."
  },
  "1052071": {
    "ENU": "You are currently a squire to another player.  If you are enjoying your experience with your sponsor click 'continue'. If you are not getting what you want out of the partnership and would like to be brought to Haven click 'stop'.",
    "PTB": "Você é atualmente escudeiro de outro jogador. Se estiver gostando da sua experiência com seu patrocinador, clique em 'continuar'. Se não estiver obtendo o que deseja da parceria e quiser ser levado a Haven, clique em 'parar'."
  },
  "1052072": {
    "ENU": "Continue",
    "PTB": "Continuar"
  },
  "1052073": {
    "ENU": "Stop",
    "PTB": "Parar"
  },
  "1052074": {
    "ENU": "Your squire has decided to leave.",
    "PTB": "Seu escudeiro decidiu sair."
  },
