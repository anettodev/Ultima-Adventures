  "1112198": {
    "ENU": "Humans have an increased carrying capacity above what is determined by their strength."
  },
  "1112199": {
    "ENU": "Humans regenerate hit points faster than normal."
  },
  "1112200": {
    "ENU": "Humans have a better chance at finding more resources while gathering hides, ore and lumber."
  },
  "1112201": {
    "ENU": "Humans have a basic ability in all skills, even untrained ones."
  },
  "1112202": {
    "ENU": "Elves always have the effect of a full strength Night Sight spell."
  },
  "1112203": {
    "ENU": "Elves have an increased energy resistance cap. Elven players must still increase their actual resistances through normal means (i.e. through equipment and magical effects)."
  },
  "1112204": {
    "ENU": "Elves receive an increase to their chance of acquiring special resources such as colored ore when mining or special boards when lumberjacking."
  },
  "1112205": {
    "ENU": "Elves are more difficult to track than other races."
  },
  "1112206": {
    "ENU": "Elves gain an increased chance to passively detect hidden monsters and enemies."
  },
  "1112207": {
    "ENU": "Elves receive a bonus to their maximum mana."
  },
  "1112208": {
    "ENU": "A Gargoyle's powerful wings carry them over land as fast as a galloping horse and grant them access to special Gargoyle-only areas."
  },
  "1112209": {
    "ENU": "In situations of great danger, a Gargoyle's natural ferocity will take over, granting speed and power at the cost of defenses."
  },
  "1112210": {
    "ENU": "A strong cultural emphasis on art and craftsmanship grants the Gargoyles an increased chance to imbue and unravel magical items."
  },
  "1112211": {
    "ENU": "All Gargoyles are trained from childhood in the skill of Throwing, giving them a basic competence with missile weapons."
  },
  "1112212": {
    "ENU": "Gargoyles have an intuitive understanding of Mysticism, allowing them to cast basic Mysticism spells without further training."
  },
