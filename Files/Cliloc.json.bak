    "ENU": "9th Anniversary Milk"
  },
  "1076776": {
    "ENU": "Want something really special? Of course you do!"
  },
  "1076777": {
    "ENU": "You receive a special treat!"
  },
  "1076778": {
    "ENU": "Here you go! Enjoy!"
  },
  "1076779": {
    "ENU": "All right...This better not spoil your dinner!"
  },
  "1076780": {
    "ENU": "Please select your ladder position.  <br>Use the ladders marked (castle) <br> for accessing the tops of keeps <br> and castles."
  },
  "1076781": {
    "ENU": "There is little chance of getting candy from that!"
  },
