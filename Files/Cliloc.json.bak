  },
  "1073207": {
    "ENU": "Wolves are known to travel in packs."
  },
  "1073208": {
    "ENU": "Quagmire and many other swamp creatures are made almost entirely out of plant material."
  },
  "1073209": {
    "ENU": "Silver Steeds are nearly extinct. The few remaining steeds are living mythical creatures."
  },
  "1073210": {
    "ENU": "The Sphynx is a highly intelligent and dangerous creature."
  },
  "1073211": {
    "ENU": "Reptalons are fierce, but can be trained by patient expert tamers."
  },
  "1073212": {
    "ENU": "Drakes belong to the dragon family. When angered they snort fire at enemies."
  },
  "1073213": {
    "ENU": "Wyverns have scorpion-like stingers that inject toxic poison into their victims."
  },
  "1073214": {
    "ENU": "A cold catch from the sea is a Polar Bear's favorite mealtime treat."
  },
  "1073215": {
    "ENU": "The Yamandon has the strength of 10 Bulls."
  },
  "1073216": {
    "ENU": "Cranes are endemic to the Tokuno Islands. Few survive captivity."
  },
  "1073217": {
    "ENU": "The Britannia Royal Zoo depends on the donations of Sosaria's fine citizens."
  },
  "1073218": {
    "ENU": "Changelings are known to imitate their predators and prey as a defense mechanism."
  },
  "1073219": {
    "ENU": "Interactive Silver Steed Contribution Statue"
  },
  "1073220": {
    "ENU": "You must have completed the epic arcanist quest to use this ability."
