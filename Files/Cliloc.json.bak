  },
  "1073641": {
    "ENU": "A Reward Title: Eminent Vesper Museum Contributor"
  },
  "1073642": {
    "ENU": "Are you sure you want to follow the elven ways?"
  },
  "1073643": {
    "ENU": "Are you sure you wish to embrace your humanity?"
  },
  "1073644": {
    "ENU": "You must complete all the tasks before proceeding..."
  },
