  "1062486": {
    "ENU": "A vendor cannot exist at that location.  Please try again.",
    "PTB": "Um vendedor não pode existir nesse local. Por favor, tente novamente."
  },
  "1062487": {
    "ENU": "You are about to be traded a home that has active vendor contracts.  While there are active vendor contracts in this house, you <strong>cannot</strong> demolish <strong>OR</strong> customize the home.  When you accept this house, you also accept landlordship for every contract vendor in the house.",
    "PTB": "Você está prestes a ser trocado para uma casa com contratos de vendedor ativos. Enquanto houver contratos de vendedor ativos nesta casa, você <strong>não pode</strong> demolir <strong>OU</strong> personalizar a casa. Ao aceitar esta casa, você também aceita a administração de todos os contratos de vendedor na casa."
  },
  "1062488": {
    "ENU": "The instrument you are trying to play is no longer in your backpack!",
    "PTB": "O instrumento que você está tentando tocar não está mais em sua mochila!"
  },
  "1062489": {
    "ENU": "This house is already being traded.  Please wait.",
    "PTB": "Esta casa já está sendo negociada. Por favor, aguarde."
  },
  "1062490": {
    "ENU": "That action would exceed the maximum number of barkeeps for this house.",
    "PTB": "Essa ação excederia o número máximo de barkeeps para esta casa."
  },
  "1062491": {
    "ENU": "You cannot use the house decorator on that object.",
    "PTB": "Você não pode usar o decorador da casa nesse objeto."
  },
  "1062492": {
    "ENU": "You cannot place a rental contract in a locked down container.",
    "PTB": "Você não pode colocar um contrato de aluguel em um recipiente bloqueado."
  },
  "1062493": {
    "ENU": "Your vendor has sufficient funds for operation and cannot accept this gold.",
    "PTB": "Seu vendedor tem fundos suficientes para operação e não pode aceitar este ouro."
  },
  "1062494": {
    "ENU": "Enter a new name for your vendor (20 characters max):",
    "PTB": "Digite um novo nome para seu vendedor (máximo 20 caracteres):"
  },
  "1062495": {
    "ENU": " "
  },
  "1062496": {
    "ENU": "Your vendor has been renamed.",
    "PTB": "Seu vendedor foi renomeado."
  },
  "1062497": {
    "ENU": "Demolition Pending",
    "PTB": "Demolição Pendente"
  },
  "1062498": {
    "ENU": "reserved for vendor ~1_NAME~",
    "PTB": "reservado para vendedor ~1_NAME~"
  },
  "1062499": {
    "ENU": "Renewal Price",
    "PTB": "Preço de Renovação"
  },
  "1062500": {
    "ENU": "Enter contract renewal price:",
    "PTB": "Digite o preço de renovação do contrato:"
  },
  "1062501": {
    "ENU": "The landlord for this vendor is offering you a partial refund of your rental fee in exchange for immediate termination of your rental contract.<BR><BR>If you accept this offer, the vendor will be immediately dismissed.  You will then be able to claim the inventory and any funds the vendor may be holding for you via a context menu on the house sign for this house.",
    "PTB": "O locador deste vendedor está oferecendo um reembolso parcial da sua taxa de aluguel em troca da rescisão imediata do seu contrato de aluguel.<BR><BR>Se você aceitar esta oferta, o vendedor será imediatamente dispensado. Você poderá então reivindicar o inventário e quaisquer fundos que o vendedor possa estar mantendo para você através de um menu de contexto no letreiro da casa."
  },
  "1062502": {
    "ENU": "Refund amount:",
    "PTB": "Valor do reembolso:"
  },
  "1062503": {
    "ENU": "Enter the amount of gold you wish to offer the renter in exchange for immediate termination of this contract?",
    "PTB": "Digite o valor de ouro que você deseja oferecer ao locatário em troca da rescisão imediata deste contrato?"
  },
  "1062504": {
    "ENU": "Please wait while the renter considers your offer.",
    "PTB": "Por favor, aguarde enquanto o locatário considera sua oferta."
  },
  "1062505": {
    "ENU": "The renter must be closer to the vendor in order for you to make this offer.",
    "PTB": "O locatário deve estar mais próximo do vendedor para que você possa fazer esta oferta."
  },
  "1062506": {
    "ENU": "You did not enter a valid amount.  Offer canceled.",
    "PTB": "Você não inseriu um valor válido. Oferta cancelada."
  },
  "1062507": {
    "ENU": "You do not have that much money in your bank account.",
    "PTB": "Você não tem esse valor em sua conta bancária."
  },
