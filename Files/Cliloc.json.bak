  "1043129": {
    "ENU": "Thou are giving me ~1_ITEM_NAME~?"
  },
  "1043130": {
    "ENU": "I shall be avenged!"
  },
  "1043131": {
    "ENU": "NOOoooo!"
  },
  "1043132": {
