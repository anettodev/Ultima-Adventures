  "1041119": {
    "ENU": "a greater shard of Astaroth"
  },
  "1041120": {
    "ENU": "a lesser shard of Astaroth"
  },
  "1041121": {
    "ENU": "a greater shard of Nosfentor"
  },
  "1041122": {
    "ENU": "a lesser shard of Nosfentor"
