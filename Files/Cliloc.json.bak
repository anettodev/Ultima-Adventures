  "1073266": {
    "ENU": "The most destructive spell - Armageddon - was first learned from the wisps."
  },
  "1073267": {
    "ENU": "Mondain gained the Gem of Immortality after murdering his father."
  },
  "1073268": {
    "ENU": "Lord British established the Order Guards. Lord Blackthorn countered by forming the Chaos Guards."
  },
  "1073269": {
    "ENU": "Minax's army, led by Juo'nar, staged a war in Trinsic before it was saved by Dupre and his followers."
  },
  "1073270": {
    "ENU": "Trammel was created by a powerful spell cast by Lord British and Nystul."
  },
  "1073271": {
    "ENU": "Illshenar was discovered by a mage named Gilforn."
  },
  "1073272": {
    "ENU": "Orcs staged battles across Sosaria. The war was centered in Cove."
  },
  "1073273": {
    "ENU": "The gargoyle city, Ver Lor Reg, was discovered in Ilshenar."
  },
  "1073274": {
    "ENU": "Yew was turned into swamplands after Adranath's 'Decay Spell' yielded unexpected results."
  },
  "1073275": {
    "ENU": "There are Eight Companions and Eight Virtues. "
  },
  "1073276": {
    "ENU": "Some Gypsies are as wise as the wisest sages of the lands."
  },
  "1073277": {
    "ENU": "Lord CrawWorth discovered the \"Lost Lands\"."
  },
  "1073278": {
    "ENU": "The Virtues - are Humility, Sacrifice, Honor, Compassion, Valor, Honesty, Spirituality and Justice."
  },
  "1073279": {
    "ENU": "There are Eight Companions and Eight Virtues."
  },
  "1073280": {
    "ENU": "The Monks of Empath Abbey are reknowned for their wine."
  },
  "1073281": {
    "ENU": "Truth, Love and Courage are the three principles that make up the eight Virtues."
  },
  "1073282": {
    "ENU": "<div align=left>Presented as community-minded and strongly principled, <b><i>Gargoyles</i></b> have special traits and abilities:<br>- A Gargoyle's powerful wings carry them over land as fast as a galloping horse and grant them access to special Gargoyle-only areas.<br>- In situations of great danger, a Gargoyle's natural ferocity will take over, granting speed and power at the cost of defenses.<br>- A strong cultural emphasis on art and craftsmanship grants the Gargoyles an increased chance to imbue and unravel magical items.<br>- All Gargoyles are trained from childhood in the skill of Throwing, giving them a basic competence with missile weapons.<br>- Gargoyles have an intuitive understanding of Mysticism, allowing them to cast basic Mysticism spells without further training.<br>- The Stygian Abyss Expansion Pack is required to create a character of this race.</div>"
  },
  "1073283": {
    "ENU": "The Codex of Ultimate Wisdom embodies all that is to be known. One only has to open a page."
  },
  "1073284": {
    "ENU": "Moonstones were once used to travel between Trammel and Felucca."
  },
  "1073285": {
    "ENU": "Relvinian descended into madness while in the Hedge Maze."
  },
  "1073286": {
    "ENU": "Trammel and Felucca are named after Sosaria's moons."
  },
