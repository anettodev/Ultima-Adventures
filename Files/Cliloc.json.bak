  "1073227": {
    "ENU": "Reptalons have the largest known talons."
  },
  "1073228": {
    "ENU": "The Silver Steed consumes more than 8 bales of hay each day."
  },
  "1073229": {
    "ENU": "Polar Bears are playful creatures."
  },
  "1073230": {
    "ENU": "Dragon's breathe is hot enough to melt silver."
  },
  "1073231": {
    "ENU": "There are several variations of wolves. The Dire Wolf is the most feared of the bunch."
  },
  "1073232": {
    "ENU": "The Bake Kitsune has three tails."
