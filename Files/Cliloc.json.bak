  },
  "1063097": {
    "ENU": "You must be wielding a melee weapon without a shield to use this ability."
  },
  "1063098": {
    "ENU": "You focus all of your abilities and strike with deadly force!"
  },
  "1063099": {
    "ENU": "Your Ki Attack must be complete within 2 seconds for the damage bonus!"
  },
  "1063100": {
    "ENU": "Your quick flight to your target causes extra damage as you strike!"
  },
  "1063101": {
    "ENU": "You were too close to your target to cause any additional damage."
  },
  "1063102": {
