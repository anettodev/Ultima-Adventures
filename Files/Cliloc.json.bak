  "1076751": {
    "ENU": "<body>When a ninja equips the Talisman of the Fey, it will permit him to use his Animal Form ability to transform into one of the newly-discovered creatures.<br>+10 Stealing Skill.</body>"
  },
  "1076752": {
    "ENU": "<body>When a ninja equips the Talisman of the Fey, it will permit him to use his Animal Form ability to transform into one of the newly-discovered creatures.<br>Become a squirrel! Amaze your friends! Be the life of the party!</body>"
  },
  "1076753": {
    "ENU": "<body>When a ninja equips the Talisman of the Fey, it will permit him to use his Animal Form ability to transform into one of the newly-discovered creatures.<br>Auto-heals using bandages in backpack.</body>"
  },
  "1076754": {
    "ENU": "<body>When a ninja equips the Talisman of the Fey, it will permit him to use his Animal Form ability to transform into one of the newly-discovered creatures.<br>Breathes fire when attacking.</body>"
  },
  "1076755": {
    "ENU": "Talisman of the Fey<br>Ferret<br>Mondain's Legacy Required"
