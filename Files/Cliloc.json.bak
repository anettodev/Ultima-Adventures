  },
  "1072518": {
    "ENU": "Your house has gained increased secure storage.",
    "PTB": "Sua casa ganhou armazenamento seguro adicional."
  },
  "1072519": {
    "ENU": "Increased Storage",
    "PTB": "Armazenamento Aumentado"
  },
  "1072520": {
    "ENU": "Runebooks for victory!",
    "PTB": "Livros de Runas para a vitória!"
  },
  "1072521": {
    "ENU": "To win this war, our fighters need runebooks to bypass the frontlines.  Bring me runebooks and I shall reward you.",
    "PTB": "Para vencer esta guerra, nossos lutadores precisam de livros de runas para ultrapassar as linhas de frente. Traga-me livros de runas e eu o recompensarei."
  },
  "1072522": {
    "ENU": "You haven't brought enough runebooks.  Come back when you have all that I need.",
    "PTB": "Você não trouxe livros de runas suficientes. Volte quando tiver todos os que preciso."
  },
  "1072523": {
    "ENU": "You find an artifact, but your backpack and bank are too full to hold it.",
    "PTB": "Você encontra um artefato, mas sua mochila e banco estão cheios demais para guardá-lo."
  },
  "1072524": {
    "ENU": "You repair the golem.",
    "PTB": "Você repara o golem."
  },
  "1072525": {
    "ENU": "<CENTER>Are you sure you want to teleport <BR>your party to an unknown area?</CENTER>",
    "PTB": "<CENTER>Tem certeza de que deseja teleportar <BR>seu grupo para uma área desconhecida?</CENTER>"
  },
  "1072526": {
    "ENU": "If you die in a teleported place, your corpse will remain there and you may not be able to recover items. Is this ok?",
    "PTB": "Se você morrer em um local teleportado, seu corpo permanecerá lá e você pode não ser capaz de recuperar os itens. Está bem?"
  },
  "1072527": {
    "ENU": "You allure the humanoid to follow and protect you.",
    "PTB": "Você seduz o humanóide a seguir e protegê-lo."
  },
  "1072528": {
    "ENU": "The humanoid becomes enraged by your charming attempt and attacks you.",
    "PTB": "O humanóide fica furioso com sua tentativa de encantar e o ataca."
  },
  "1072529": {
    "ENU": "You cannot use that for another ~1_NUM~ ~2_TIMEUNITS~",
    "PTB": "Você não pode usar isso novamente por ~1_NUM~ ~2_TIMEUNITS~"
  },
  "1072530": {
    "ENU": "seconds",
    "PTB": "segundos"
  },
  "1072531": {
    "ENU": "minutes",
    "PTB": "minutos"
  },
