  "1041525": {
    "ENU": "<U>Young player haven transport</U>: Select this option if you want to be transported to Haven.",
    "PTB": "<U>Transporte para jovens em Haven</U>: Selecione esta opção se quiser ser transportado para Haven."
  },
  "1041526": {
    "ENU": "<u>Go to Haven.</u> This option will take you to the city of Haven. Haven is a place of learning for newcomers to Britannia.",
    "PTB": "<u>Ir para Haven.</u> Esta opção levará você para a cidade de Haven. Haven é um lugar de aprendizado para novatos em Britannia."
  },
  "1041527": {
    "ENU": "<CENTER>We apologize, but the normal support options are currently unavailable.",
    "PTB": "<CENTER>Pedimos desculpas, mas as opções de suporte normais estão indisponíveis no momento."
  },
  "1041528": {
    "ENU": "<CENTER>Test Center is a resource used by Quality Assurance and Development teams. Support representatives are not available on test shards.",
    "PTB": "<CENTER>Centro de Teste é um recurso usado pelas equipes de Garantia de Qualidade e Desenvolvimento. Representantes de suporte não estão disponíveis em test shards."
  },
  "1041529": {
    "ENU": "You're already in New Haven.",
    "PTB": "Você já está em New Haven."
  },
  "1041530": {
    "ENU": "You'll need a better jailbreak plan then that!",
    "PTB": "Você precisará de um plano de fuga melhor do que esse!"
  },
  "1041531": {
    "ENU": "You have changed the title of the rune book.",
    "PTB": "Você alterou o título do livro de runas."
  },
  "1041532": {
    "ENU": "the magic lamp of the ~1_SHIP_NAME~",
    "PTB": "a lâmpada mágica do ~1_SHIP_NAME~"
  },
  "1041533": {
    "ENU": "This carpet is now called the ~1_NEW_SHIP_NAME~.",
    "PTB": "Este tapete agora se chama ~1_NEW_SHIP_NAME~."
  },
  "1041534": {
    "ENU": "You must be on the carpet to open the bag.",
    "PTB": "Você deve estar no tapete para abrir a bolsa."
  },
  "1041535": {
    "ENU": "I can not open the bag while the carpet is moving.",
    "PTB": "Não posso abrir a bolsa enquanto o tapete estiver se movendo."
  },
  "1041536": {
    "ENU": "The carpet is already steady, my master.",
    "PTB": "O tapete já está estável, meu mestre."
  },
  "1041537": {
    "ENU": "The carpet is steadied, my master.",
    "PTB": "O tapete está estabilizado, meu mestre."
  },
  "1041538": {
    "ENU": "The carpet has not been steadied, my master.",
    "PTB": "O tapete não foi estabilizado, meu mestre."
  },
  "1041539": {
    "ENU": "The carpet is ready to glide, my master.",
    "PTB": "O tapete está pronto para deslizar, meu mestre."
  },
  "1041540": {
    "ENU": "Yes, my master.",
    "PTB": "Sim, meu mestre."
  },
  "1041541": {
    "ENU": "What name do you want for this carpet, my master?",
    "PTB": "Que nome você quer para este tapete, meu mestre?"
  },
  "1041542": {
    "ENU": "Only my master may name this carpet.",
    "PTB": "Apenas meu mestre pode nomear este tapete."
  },
  "1041543": {
    "ENU": "Yes, my master.",
    "PTB": "Sim, meu mestre."
  },
  "1041544": {
    "ENU": "This carpet now has no name.",
    "PTB": "Este tapete agora não tem nome."
  },
  "1041545": {
    "ENU": "This carpet has no name.",
    "PTB": "Este tapete não tem nome."
  },
  "1041546": {
    "ENU": "I have no current nav point, my master.",
    "PTB": "Não tenho nenhum ponto de navegação atual, meu mestre."
  },
  "1041547": {
    "ENU": "That is no a map, my master.",
    "PTB": "Isso não é um mapa, meu mestre."
  },
  "1041548": {
    "ENU": "That map has no course on it, my master.",
    "PTB": "Esse mapa não tem curso, meu mestre."
  },
  "1041549": {
    "ENU": "You have a map, my master.",
    "PTB": "Você tem um mapa, meu mestre."
