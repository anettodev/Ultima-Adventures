  },
  "1115333": {
    "ENU": "This item only works on runebooks."
  },
  "1115334": {
    "ENU": "Log Out"
  },
  "1115335": {
    "ENU": "Logs your character out and returns you back to the Login Screen."
  },
  "1115336": {
    "ENU": "You must upgrade to The Stygian Abyss expansion to participate in this quest."
  },
