  },
  "1076304": {
    "ENU": "Why hello my dear!"
  },
  "1076305": {
    "ENU": "Why hello Sherry!"
  },
  "1076306": {
    "ENU": "Hail, milady"
  },
  "1076307": {
    "ENU": "Hail, Sherry"
  },
  "1076308": {
    "ENU": "Good morning"
