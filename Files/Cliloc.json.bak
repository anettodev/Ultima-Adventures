  },
  "1115826": {
    "ENU": "You kill one of the Ophidians in the back ranks of their army and gain little recognition."
  },
  "1115827": {
    "ENU": "You kill one of the Bane Chosen in the back ranks of their army and gain little recognition."
  },
  "1115828": {
    "ENU": "You assist the Bane Chosen in pushing back the Ophidian army."
  },
  "1115829": {
    "ENU": "You assist the Ophidians in pushing back the Bane Chosen army."
  },
  "1115830": {
    "ENU": "The Ophidians have secured this location, the front line has moved up!"
  },
  "1115831": {
