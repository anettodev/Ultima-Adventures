    "PTB": "Nome da Loja:"
  },
  "1062510": {
    "ENU": "Refund Amount:",
    "PTB": "Valor do Reembolso:"
  },
  "1062511": {
    "ENU": "Agree, and <strong>dismiss vendor</strong>",
    "PTB": "Concordo, e <strong>dispensar vendedor</strong>"
