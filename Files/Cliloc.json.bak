  "1072619": {
    "ENU": "A deed for a Parrot Perch"
  },
  "1072620": {
    "ENU": "Includes a pet Parrot"
  },
  "1072621": {
    "ENU": "In the distance, you can see a way through the debris."
  },
  "1072622": {
    "ENU": "That name isn't very polite."
  },
  "1072623": {
