  "1062436": {
    "ENU": "The vendor you selected had ~1_COUNT~ items in its inventory, and ~2_AMOUNT~ gold in its account.",
    "PTB": "O vendedor que você selecionou tinha ~1_COUNT~ itens em seu inventário e ~2_AMOUNT~ de ouro em sua conta."
  },
  "1062437": {
    "ENU": "~1_COUNT~ items have been removed from the shop inventory and placed in your backpack.  ~2_BANKCOUNT~ items were removed from the shop inventory and placed in your bank box.",
    "PTB": "~1_COUNT~ itens foram removidos do inventário da loja e colocados em sua mochila. ~2_BANKCOUNT~ itens foram removidos do inventário da loja e colocados em sua caixa bancária."
  },
  "1062438": {
    "ENU": "The shop is now empty of inventory and funds, so it has been deleted.",
    "PTB": "A loja agora está vazia de inventário e fundos, então foi excluída."
  },
  "1062439": {
    "ENU": "The shop still has some inventory to be reclaimed, but you cannot carry any more.  Please make room in your backpack and try again.",
    "PTB": "A loja ainda tem alguns inventários para serem recuperados, mas você não pode carregar mais. Por favor, faça espaço em sua mochila e tente novamente."
  },
  "1062440": {
    "ENU": "Some of the shop inventory would not fit in your backpack or bank box.  Please free up some room and try again.",
    "PTB": "Alguns dos inventários da loja não caberiam em sua mochila ou caixa bancária. Por favor, libere algum espaço e tente novamente."
  },
  "1062441": {
