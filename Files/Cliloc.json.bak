  "1019004": {
    "ENU": "You are not allowed to travel there."
  },
  "1019005": {
    "ENU": "<center><basefont color=#0000FF>WARNING</center>"
  },
  "1019006": {
    "ENU": "<center><basefont color=#0000FF>ATTENTION</center>"
  },
  "1019007": {
    "ENU": "<center>You are considered a murderer.  You will not be able to travel to this destination more than once a month.</center>"
  },
  "1019008": {
    "ENU": "<center>Are you sure you wish to travel now?</center>"
  },
  "1019009": {
    "ENU": "<center>You are considered a murderer and you have been through the moongate once this month already.  You will not be allowed back through the moongate.</center>"
  },
  "1019010": {
    "ENU": "<center>You are currently in stat loss, and you will not be able to gain skills while at the destination.</center>"
  },
  "1019011": {
    "ENU": "You get yourself ready to stun your opponent."
  },
  "1019012": {
    "ENU": "You decide to not try to stun anyone."
  },
  "1019013": {
    "ENU": "You get yourself ready to disarm your opponent."
  },
  "1019014": {
    "ENU": "You decide to not try to disarm anyone."
  },
  "1019015": {
    "ENU": "You may not cast Gate Travel while riding a seahorse."
  },
  "1019016": {
    "ENU": "You may not cast Recall while riding a seahorse."
  },
  "1019017": {
    "ENU": "You may not teleport while riding a seahorse."
  },
  "1019018": {
    "ENU": "You must summon a seahorse of your own if you wish to ride one."
  },
  "1019019": {
    "ENU": "You have already summoned a seahorse."
  },
  "1019020": {
    "ENU": "How many charges?"
  },
  "1019021": {
    "ENU": "I cannot enchant this."
  },
  "1019022": {
    "ENU": "You do not have enough gold."
  },
  "1019023": {
    "ENU": "Do you wish to enchant this?"
  },
  "1019024": {
    "ENU": "Seahorse Summoning"
  },
  "1019025": {
    "ENU": "With great difficulty, you manage to bring your spirit and body together."
  },
