  "1007081": {
    "ENU": "Mine enemy is near!",
    "PTB": "Meu inimigo está próximo!"
  },
  "1007082": {
    "ENU": "The evil ones approach!",
    "PTB": "Os malvados se aproximam!"
  },
  "1007083": {
    "ENU": "Attack! Attack!",
    "PTB": "Ataque! Ataque!"
  },
  "1007084": {
    "ENU": "Beware, the enemy!",
    "PTB": "Cuidado, o inimigo!"
  },
  "1007085": {
    "ENU": "Quickly, must kill...",
    "PTB": "Rápido, preciso matar..."
  },
  "1007086": {
    "ENU": "Away from our territory!",
    "PTB": "Fora do nosso território!"
  },
  "1007087": {
    "ENU": "Thou dast come here?",
    "PTB": "Tu vieste aqui?"
  },
  "1007088": {
    "ENU": "The treaty is broken!",
    "PTB": "O tratado está quebrado!"
  },
  "1007089": {
    "ENU": "And so the war goeth on...",
    "PTB": "E assim a guerra continua..."
  },
  "1007090": {
    "ENU": "Ahhh... an evil one...",
    "PTB": "Ahhh... um ser maligno..."
  },
  "1007091": {
    "ENU": " Foul spiders!",
    "PTB": "Aranhas nojentas!"
  },
  "1007092": {
    "ENU": " Evil clicking things...",
    "PTB": "Coisas malignas e barulhentas..."
  },
  "1007093": {
    "ENU": " I hate bugs...",
    "PTB": "Eu odeio insetos..."
  },
  "1007094": {
    "ENU": " Green monsters!",
    "PTB": "Monstros verdes!"
  },
  "1007095": {
    "ENU": " Kill the many-legs!",
    "PTB": "Mate as muitas pernas!"
  },
  "1007096": {
    "ENU": " Nasty snakes!",
    "PTB": "Cobras nojentas!"
  },
  "1007097": {
    "ENU": " Evil slithering things!",
    "PTB": "Coisas malignas e deslizantes!"
  },
  "1007098": {
    "ENU": " Legless ones!",
    "PTB": "Sem pernas!"
  },
  "1007099": {
    "ENU": " Slimy fang faces!",
    "PTB": "Caras asquerosos com presas!"
  },
  "1007100": {
    "ENU": " Drone killers!",
