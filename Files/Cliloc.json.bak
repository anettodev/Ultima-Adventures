  },
  "1043023": {
    "ENU": "Goodbye.",
    "PTB": "Tchau."
  },
  "1043024": {
    "ENU": "Until Later.",
    "PTB": "Até mais tarde."
  },
  "1043025": {
    "ENU": "Until we meet again.",
    "PTB": "Até nos encontrarmos novamente."
