  "1046474": {
    "ENU": "We believe vile 'Horde Minions' are responsible for these disappearances."
  },
  "1046475": {
    "ENU": "Go forth and kill at least 6 of these 'Horde Minions'. See if you can find any evidence of our missing men."
  },
  "1046476": {
    "ENU": "You, however, have shown great Valor in your battle against the wretched 'Horde Minions'. I am pleased."
  },
  "1046477": {
    "ENU": "On your way out, be sure to take a look at the 'Horde Minion' in the cage near the water fountain."
  },
  "1046478": {
    "ENU": "You have just slain your first 'Horde Minion'.  Now is a good time to check your health and heal yourself, if need be."
  },
