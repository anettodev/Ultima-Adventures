  "1078526": {
    "ENU": "<body>Mondain's Legacy Required<br>Damage Modifier: 10%<br>Defense Chance Increase 5%<br>Lower Ammo Cost 20%<br>Weight Reduction 30%</body>"
  },
  "1078527": {
    "ENU": "<body>Mondain's Legacy Required<br>When a ninja equips the Talisman of the Fey, it will permit him to use his Animal Form ability to transform into one of the newly-discovered creatures.<br>+10 Stealing Skill.</body>"
  },
  "1078528": {
    "ENU": "<body>Mondain's Legacy Required<br>When a ninja equips the Talisman of the Fey, it will permit him to use his Animal Form ability to transform into one of the newly-discovered creatures.<br>Become a squirrel! Amaze your friends! Be the life of the party!</body>"
  },
  "1078529": {
    "ENU": "<body>Mondain's Legacy Required<br>When a ninja equips the Talisman of the Fey, it will permit him to use his Animal Form ability to transform into one of the newly-discovered creatures.<br>Auto-heals using bandages in backpack.</body>"
  },
  "1078530": {
    "ENU": "<body>Mondain's Legacy Required<br>When a ninja equips the Talisman of the Fey, it will permit him to use his Animal Form ability to transform into one of the newly-discovered creatures.<br>Breathes fire when attacking.</body>"
  },
