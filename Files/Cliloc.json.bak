  },
  "1079256": {
    "ENU": "Are you sure you wish to return to New Haven before challenging the Dark Knight? You will not be able to return for one day."
  },
  "1079257": {
    "ENU": "You find yourself back in New Haven with your corpse at your feet, a testament to a battle lost."
  },
  "1079258": {
    "ENU": "Success! The Dark Knight has fallen and you've been returned safely to New Haven."
  },
  "1079259": {
    "ENU": "In return for your deed a reward has been placed in your backpack, just this once. You will not be able to challenge him again for three days."
  },
  "1079260": {
    "ENU": "Once again you've defeated the Dark Knight, and must wait three days before challenging him again."
  },
  "1079261": {
