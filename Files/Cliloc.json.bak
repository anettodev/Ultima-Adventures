  },
  "1062950": {
    "ENU": "The Samurai is an elite warrior who seeks to achieve perfection through battle.  They strike with great accuracy, can handle multiple opponents, and have mastered the art of parrying with weapons."
  },
  "1062951": {
    "ENU": "The Ninja is an assassin who uses stealthy tactics and summons deadly magic in combat to confuse and weaken their enemy."
  },
