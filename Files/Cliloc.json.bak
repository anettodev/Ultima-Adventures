  "1041124": {
    "ENU": "a lesser shard of Faulinei"
  },
  "1041125": {
    "ENU": "One: 'Pon this eve the aether flows and dances madly in the air"
  },
  "1041126": {
    "ENU": "Two: The spirits rise and walk again and slaughter in the moon's red glare"
  },
  "1041127": {
    "ENU": "Three: Beware, ye men of mortal flesh, lest ghosts seize all thy lifespan's time"
  },
  "1041128": {
    "ENU": "Four: For soon the night shall come and soon shall set the sun"
  },
  "1041129": {
    "ENU": "Five: And soon shall rise the bones to walk and seek the magic sign..."
  },
  "1041130": {
    "ENU": "One: Soon the world shall split, and lives will lose their luster."
  },
  "1041131": {
    "ENU": "Two: The cadavers shall rise from their restless aching sleep!"
  },
  "1041132": {
    "ENU": "Three: Soon shall monsters walk with bones broke all asunder,"
  },
  "1041133": {
    "ENU": "Four: For a magic sign doth dwell in caverns dark and deep!"
  },
  "1041134": {
    "ENU": "One: Where bones of land rise broken from the earth"
  },
  "1041135": {
    "ENU": "Two: And where the wind whistles 'til the rock itself speaks,"
  },
  "1041136": {
    "ENU": "Three: By the sea, north of sandstone, south of swamp,"
  },
  "1041137": {
    "ENU": "Four: A magic sign doth rest 'pon the smallest of peaks."
  },
  "1041138": {
    "ENU": "One: Some say a message floated in a corked and sunburnt bottle"
  },
  "1041139": {
    "ENU": "Two: And washed ashore where fisherfolk found it with a smile--"
  },
  "1041140": {
    "ENU": "Three: 'Til wounds did grow upon their flesh and disease did rot:"
  },
  "1041141": {
    "ENU": "Four: A magic sign must live lonely lost upon a deserted isle."
  },
  "1041142": {
    "ENU": "One: Where swords were shattered and brothers fell"
  },
  "1041143": {
    "ENU": "Two: In battles well divided"
  },
  "1041144": {
    "ENU": "Three: Where naught can live save pride and sting"
  },
  "1041145": {
    "ENU": "Four: And dry is air in hiding"
  },
  "1041146": {
    "ENU": "Five: A magic sign is caught in sand and sun"
  },
  "1041147": {
    "ENU": "Six: Where blood lays idle"
  },
  "1041148": {
    "ENU": "One: Seek ye signs of shattered stones! Seek ye gatherings of glimmers!"
  },
  "1041149": {
    "ENU": "Two: For alas and alack and lo! they fall from heavens to tempt all the sinners..."
  },
  "1041150": {
    "ENU": "Three: Complete the prophecy to find the secret of the days to come"
  },
  "1041151": {
    "ENU": "Four: For runes and crystals whisper rhymes to frighten everyone..."
  },
  "1041152": {
    "ENU": "One: Hast thou heard the dead shall walk?"
  },
  "1041153": {
    "ENU": "Two: 'Tis prophesied here that castles fall."
  },
  "1041154": {
    "ENU": "Three: When crystals shatter and magic gathers"
  },
  "1041155": {
    "ENU": "Four: And spirits make their ghastly call."
  },
  "1041156": {
    "ENU": "One: Upon a day when snow doth fall"
  },
  "1041157": {
    "ENU": "Two: A gathering will form of noblemen"
  },
  "1041158": {
    "ENU": "Three: Among them some who quarrel still"
  },
  "1041159": {
    "ENU": "Four: Between free will and civil men"
  },
  "1041160": {
    "ENU": "Five: Whilst watched by mice and monsters both"
  },
  "1041161": {
    "ENU": "Six: A challenge shall be made"
  },
  "1041162": {
    "ENU": "Seven: That breaketh lances and severs growth"
  },
  "1041163": {
    "ENU": "Eight: And stains fair grass with hate"
  },
  "1041164": {
    "ENU": "Nine: Someday perhaps shall reconcile"
  },
  "1041165": {
    "ENU": "Ten: Two men whose hearts were once the same"
  },
  "1041166": {
    "ENU": "Eleven: 'Til then the world shall tremble dire"
  },
  "1041167": {
    "ENU": "Twelve: And none shall fix the blame..."
  },
