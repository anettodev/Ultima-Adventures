  "1010062": {
    "ENU": "Fear to ye all who pass..."
  },
  "1010063": {
    "ENU": "Speak what ye wish, and ye shall be answered in kind."
  },
  "1010064": {
    "ENU": "Ye have disturbed the dead, speak now, or begone!"
  },
  "1010065": {
    "ENU": "Begone ye who belong not here, begone or speak thy peace."
  },
  "1010066": {
    "ENU": "Cast not thy fear into the hearts of this cave."
  },
  "1010067": {
    "ENU": "I have nothing to say"
  },
  "1010068": {
    "ENU": "Three become one within these ancient halls. Remember thee this whence one encounters thy nemesis."
  },
  "1010069": {
    "ENU": "Dare ye not break the division of three, for it is a sacred division."
  },
  "1010070": {
    "ENU": "Call thee not a coward for entering this realm, beware though, that thine action might disrupt "
  },
  "1010071": {
    "ENU": "what ye seek to fine."
  },
  "1010072": {
    "ENU": "Fear not thy creatures within, for they differ from their fathers whose presence grace the land beyond "
  },
  "1010073": {
    "ENU": "the entrance to this tomb."
  },
  "1010074": {
    "ENU": "Blind forgiveness for the crimes which those shall commit against the nature of their being is the "
  },
  "1010075": {
    "ENU": "divinity within every life."
  },
  "1010076": {
    "ENU": "I have nothing to say"
  },
  "1010077": {
    "ENU": "Thou hast come a stranger and a visitor to these sacred halls."
  },
  "1010078": {
    "ENU": "Within these halls two cultures combine to feed a third that hungers in the depths below."
  },
  "1010079": {
    "ENU": "Beware thee who disrupt the balance of three, for in these halls, three doth become one."
  },
  "1010080": {
    "ENU": "Take thy gifts, thy gifts that such a shrine can give, for fate is in thy hands, and in thy hands, thy sacred number of three."
  },
