  "1112784": {
    "ENU": "Boura, Boura",
    "PTB": "Boura, Boura"
  },
  "1112785": {
    "ENU": "Raptorlicious",
    "PTB": "Raptorlicioso"
  },
  "1112786": {
    "ENU": "The Slith Wars",
    "PTB": "As Guerras Slith"
  },
  "1112787": {
