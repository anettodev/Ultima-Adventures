  "1054001": {
    "ENU": "Target the bracelet of binding you wish to bind this bracelet to."
  },
  "1054002": {
    "ENU": "You can only bind this bracelet to another bracelet of binding!"
  },
  "1054003": {
    "ENU": "You bind the bracelet to its counterpart. The bracelets glow with power."
  },
  "1054004": {
    "ENU": "You must equip the bracelet in order to use its power."
  },
  "1054005": {
    "ENU": "The bracelet glows black. It must be charged before it can be used again."
  },
  "1054006": {
    "ENU": "The bracelet emits a red glow. The bracelet's twin is not available for transport."
  },
  "1054007": {
    "ENU": "The bracelet glows with green energy, absorbing magical power from the spores."
  },
  "1054008": {
    "ENU": "The spores have no effect on this item."
  },
  "1054009": {
    "ENU": "Enter the text to inscribe upon the bracelet :"
  },
  "1054010": {
