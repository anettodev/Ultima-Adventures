    "ENU": "In recognition of the Companions, who have shared their wisdom with newcomers to our realm."
  },
  "1040000": {
    "ENU": "savage kin paint"
  },
  "1040001": {
    "ENU": "tribal berry"
  },
  "1040002": {
    "ENU": "You cannot disguise yourself while wearing body paint"
  },
  "1040003": {
    "ENU": "You cannot polymorph while wearing body paint"
  },
  "1040004": {
    "ENU": "You cannot use incognito while wearing body paint"
  },
  "1040005": {
    "ENU": "You now bear the markings of the savage tribe.  Your body paint will last about a week or you can remove it with an oil cloth."
  },
  "1040006": {
    "ENU": "You wipe away all of your body paint."
  },
  "1040007": {
    "ENU": "Your body paint has worn off!"
  },
  "1040008": {
    "ENU": "Your skin is scorched as the tribal paint burns away!"
  },
  "1040009": {
    "ENU": "With a sack of flour a cook could make this into the body paint used by the savages."
  },
  "1040010": {
    "ENU": "You combine the berry and the flour into the tribal paint worn by the savages."
  },
  "1040011": {
    "ENU": "a bola"
  },
  "1040012": {
    "ENU": "bola ball"
  },
  "1040013": {
    "ENU": "You begin to swing the bola"
  },
  "1040014": {
    "ENU": "With 4 of these and 3 strips of leather a good tinker could make a working bola."
  },
  "1040015": {
    "ENU": "Your hands must be free to use this"
  },
  "1040016": {
    "ENU": "You cannot use this while riding a mount"
  },
  "1040017": {
    "ENU": "You can't throw this at yourself"
  },
  "1040018": {
    "ENU": "You have no reason to throw a bola at that"
  },
  "1040019": {
    "ENU": "The bola must be in your pack to use it."
  },
  "1040020": {
    "ENU": "You must wait a few moments before you can throw another bola"
  },
  "1040021": {
    "ENU": "That is already being used."
  },
  "1040022": {
    "ENU": "You fail to knock the rider from their mount."
  },
  "1040023": {
    "ENU": "You have been knocked off of your mount!"
  },
  "1040024": {
    "ENU": "You are still too dazed from being knocked off your mount to ride!"
  },
  "1040025": {
    "ENU": "You make the bola and place it in your pack."
  },
  "1040026": {
    "ENU": "You do not have enough bola balls to make this."
  },
  "1040027": {
    "ENU": "You do not have enough leather to make this."
  },
  "1040028": {
    "ENU": "You fail to make the bola and ruin the leather in the process."
  },
