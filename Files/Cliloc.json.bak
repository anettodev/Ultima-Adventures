  "1080501": {
    "ENU": "Ah..."
  },
  "1080502": {
    "ENU": "Looking for something?"
  },
  "1080503": {
    "ENU": "Kronos, perhaps?"
  },
  "1080504": {
    "ENU": "Oh wait, he's dead!"
  },
  "1080505": {
    "ENU": "Or maybe it's someone of a more... manly demeanor. Avery, was it?"
  },
  "1080506": {
    "ENU": "Pity. You came all this way just to die."
  },
  "1080507": {
    "ENU": "Fools!"
  },
  "1080508": {
    "ENU": "This."
  },
  "1080509": {
    "ENU": "Isn't."
  },
  "1080510": {
    "ENU": "Over."
  },
  "1080511": {
    "ENU": "I'm free! You've saved me! They've had me..."
  },
  "1080512": {
    "ENU": "Avery! We've caught you at last!"
  },
  "1080513": {
    "ENU": "What is this!?"
  },
  "1080514": {
    "ENU": "You are under arrest for the murder of the Royal Council!"
  },
  "1080515": {
    "ENU": "Help me!"
  },
  "1080516": {
    "ENU": "At last, we'll bring the criminal to justice"
  },
  "1080517": {
    "ENU": "Your kingdom thanks you"
  },
  "1080518": {
    "ENU": "You have already begun the battle!"
  },
  "1080519": {
    "ENU": "You must wait a while before trying again..."
  },
