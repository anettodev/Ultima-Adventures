  "1149964": {
    "ENU": "This creature has been tamed, it is no longer connected to the elder demons."
  },
  "1149965": {
    "ENU": "hellhound treat"
  },
  "1149966": {
    "ENU": "The ancient hellhounds recognize their kindred and unite against you. Good luck!"
  },
  "1149967": {
    "ENU": "*CAUTION* You are under the following ENHANCE ITEM buff. Do you want to remove it?"
  },
  "1149968": {
    "ENU": "REMOVE"
  },
  "1149969": {
    "ENU": "The magical aura that surrounded you disipates and you feel that your item enhancement chances have returned to normal."
  },
  "1149970": {
    "ENU": "Greetings friend, please give a donation to the Help a Hellhound Society."
  },
  "1149971": {
    "ENU": "Hellhounds are such cuddly creatures, don't you think they deserve a treat?"
  },
  "1149972": {
    "ENU": "I think you would be a perfect person to be a treat for a hellhound... I mean buy, buy a treat for a hellhound."
  },
  "1149973": {
    "ENU": "Excellent, more halloween customers.  Come, buy a treat and feed the hellhounds."
  },
  "1149974": {
    "ENU": "The hellhound population is at risk! Buy a treat for them.  From me."
  },
  "1149975": {
    "ENU": "Welcome friend, the hellhounds have been waiting for you to visit me."
