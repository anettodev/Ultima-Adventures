  "1042693": {
    "ENU": "Beware Ye Who Enter These Halls!"
  },
  "1042694": {
    "ENU": "Go no farther, lest ye face thy death."
  },
  "1042695": {
    "ENU": "You magically create food in your backpack:"
  },
  "1042696": {
    "ENU": "Fear ye all who pass!"
  },
  "1042697": {
    "ENU": "Speak what ye wish, and ye shall be answered in kind."
  },
  "1042698": {
    "ENU": "Ye have disturbed the dead, speak now, or be gone!"
  },
  "1042699": {
    "ENU": "Be gone ye who belong not here, be gone or speak thy peace."
  },
  "1042700": {
    "ENU": "Cast not thy fears into the heart of this cave."
  },
  "1042701": {
    "ENU": "Fear not death my friend, for it is the beginning, not the end."
  },
  "1042702": {
    "ENU": "Three become one within these ancient halls.  Remember thee this whence thou encounters thy nemesis."
  },
  "1042703": {
    "ENU": "Dare ye not break the division of three, for it is a sacred division."
  },
  "1042704": {
    "ENU": "Call thee not a coward for entering this ream, beware though that thine action might disrupt what ye seek to find."
  },
  "1042705": {
    "ENU": "Fear not the creatures within, for they differ from their fathers, whose presence grace the land beyond the entrance of this tomb."
  },
  "1042706": {
    "ENU": "Blind forgiveness for the crimes which those shall commit against the nature of their being is the divinity within every life."
  },
  "1042707": {
    "ENU": "Thou hast come as a stranger and a visitor to these sacred halls."
  },
  "1042708": {
    "ENU": "Within these halls, two cultures combine to feed a third that hungers in the depths below."
  },
  "1042709": {
    "ENU": "Beware thee who disrupt the balance of three, for in these halls, three doth become one."
  },
  "1042710": {
    "ENU": "Take thy gifts, the gifts that such a shrine can give - for fate is in thy hands, and in thy hands the sacred number of three."
  },
