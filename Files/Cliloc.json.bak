  "1041552": {
    "ENU": "There is no map, my master.",
    "PTB": "Não há mapa, meu mestre."
  },
  "1041553": {
    "ENU": "The map is too far away from me, my master.",
    "PTB": "O mapa está muito longe de mim, meu mestre."
  },
  "1041554": {
    "ENU": "I do not see the nav point, my master.",
    "PTB": "Não vejo o ponto de navegação, meu mestre."
  },
  "1041555": {
