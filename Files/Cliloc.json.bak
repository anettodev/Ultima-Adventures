  "1080279": {
    "ENU": "Bloody Pentagram",
    "PTB": "Pentágrama Sangrento"
  },
  "1080280": {
    "ENU": "I shall be avenged!",
    "PTB": "Serei vingado!"
  },
  "1080281": {
    "ENU": "NOOooo!",
    "PTB": "NÃÃÃooo!"
  },
  "1080282": {
    "ENU": "I shall be avenged!",
    "PTB": "Serei vingado!"
  },
  "1080283": {
    "ENU": "I... I...",
    "PTB": "Eu... Eu..."
  },
  "1080284": {
    "ENU": "No, I don't want to die...",
    "PTB": "Não, não quero morrer..."
  },
  "1080285": {
    "ENU": "Argh! I am slain!",
    "PTB": "Argh! Fui morto!"
  },
  "1080286": {
    "ENU": "Must stay... on feet...",
    "PTB": "Preciso ficar... de pé..."
  },
  "1080287": {
    "ENU": "Oooh, that doth hurt...",
    "PTB": "Oooh, isso dói..."
  },
  "1080288": {
    "ENU": "Am I dying?",
    "PTB": "Estou morrendo?"
  },
  "1080289": {
    "ENU": "Whatever shall my family do without me?",
    "PTB": "O que minha família fará sem mim?"
  },
  "1080290": {
    "ENU": "I hope the guards catch thee, scum!",
    "PTB": "Espero que os guardas te peguem, escória!"
  },
  "1080291": {
    "ENU": "Ooh... that doth hurt.",
    "PTB": "Oooh... isso dói."
  },
  "1080292": {
    "ENU": "Must I die?",
    "PTB": "Tenho que morrer?"
  },
  "1080293": {
    "ENU": "Curse thee!",
    "PTB": "Maldição sobre ti!"
  },
  "1080294": {
    "ENU": "I shall be avenged...",
    "PTB": "Serei vingado..."
  },
  "1080295": {
    "ENU": "I shall haunt thee for this deed!",
    "PTB": "Vou te assombrar por esta ação!"
  },
  "1080296": {
    "ENU": "I spit on thee...",
    "PTB": "Cuspo em ti..."
  },
  "1080297": {
    "ENU": "Ha! I knew that I could do it!",
    "PTB": "Ha! Sabia que podia fazer isso!"
  },
  "1080298": {
    "ENU": "Thou shouldst not have messed with me!",
    "PTB": "Não deveria ter mexido comigo!"
  },
  "1080299": {
    "ENU": "Die, pathetic fool!",
    "PTB": "Morra, tolo patético!"
  },
  "1080300": {
    "ENU": "Thou deservest to die!",
    "PTB": "Mereces morrer!"
  },
  "1080301": {
    "ENU": "There, that taketh care of thee.",
    "PTB": "Pronto, isso resolve você."
  },
  "1080302": {
    "ENU": "So perish those who challenge me!",
    "PTB": "Assim perecem aqueles que me desafiam!"
  },
  "1080303": {
    "ENU": "Thou shouldst not have fought me.",
    "PTB": "Não deveria ter lutado comigo."
  },
  "1080304": {
    "ENU": "May thy soul rest in peace.",
    "PTB": "Que tua alma descanse em paz."
  },
  "1080305": {
    "ENU": "May thy shade wander the wilderness forever!",
    "PTB": "Que tua sombra vague pela wilderness para sempre!"
  },
  "1080306": {
    "ENU": "Have done with thee!",
    "PTB": "Acabou para ti!"
  },
  "1080307": {
    "ENU": "Ha! Thou art inept!",
    "PTB": "Ha! És inábil!"
  },
  "1080308": {
    "ENU": "Thou didst miss, fool!",
    "PTB": "Erraste, tolo!"
  },
  "1080309": {
    "ENU": "Thy aim is bad...",
    "PTB": "Tua mira é ruim..."
  },
  "1080310": {
    "ENU": "Surely thou canst do better than that blow!",
    "PTB": "Certamente podes fazer melhor que este golpe!"
  },
  "1080311": {
    "ENU": "Thou dost hit only air!",
    "PTB": "Só atinges o ar!"
  },
  "1080312": {
    "ENU": "Thou art no match for me!",
    "PTB": "Não és páreo para mim!"
  },
  "1080313": {
    "ENU": "Ouch! Thou didst scratch me!",
    "PTB": "Ai! Você me arranhou!"
  },
  "1080314": {
    "ENU": "Barely a flesh wound. Canst thou not do better?",
    "PTB": "Apenas um arranhão. Não consegues fazer melhor?"
  },
  "1080315": {
    "ENU": "Pfft, thou fightest badly.",
    "PTB": "Pfft, lutas mal."
  },
  "1080316": {
    "ENU": "Surely thou canst hit harder than that!",
    "PTB": "Certamente podes golpear mais forte!"
  },
  "1080317": {
    "ENU": "A bare touch... Thou dost not wield thy weapon well!",
    "PTB": "Apenas um toque... Não empunhas bem tua arma!"
  },
  "1080318": {
    "ENU": "I eat pieces of horse dung like thou for mine morning meal!",
    "PTB": "Eu como pedaços de esterco de cavalo como tu no meu café da manhã!"
  },
  "1080319": {
    "ENU": "'Tis only a flesh wound.",
    "PTB": "É apenas um arranhão."
  },
  "1080320": {
    "ENU": "Cometh and get some!",
    "PTB": "Venha e pegue!"
  },
  "1080321": {
    "ENU": "Dost thou think that is air thou art breathing?",
    "PTB": "Achas que isso é ar que estás respirando?"
  },
  "1080322": {
    "ENU": "Bringeth it!",
    "PTB": "Traga!"
  },
  "1080323": {
    "ENU": "What is thy name?  It matters not, for I shall slay thee!",
    "PTB": "Qual é teu nome? Não importa, pois vou te matar!"
  },
  "1080324": {
    "ENU": "Who is thine father?  I am, swine!",
    "PTB": "Quem é teu pai? Eu sou, porco!"
  },
  "1080325": {
    "ENU": "Goeth ahead.  Maketh mine day.",
    "PTB": "Pode ir. Faça meu dia."
  },
  "1080326": {
    "ENU": "Ouch! A touch indeed!",
    "PTB": "Ai! Um toque, de fato!"
  },
  "1080327": {
    "ENU": "'Twill take more than that to kill me!",
    "PTB": "Vai precisar de mais que isso para me matar!"
  },
  "1080328": {
    "ENU": "Ow, thou didst get past my defenses!",
    "PTB": "Ai, você passou pela minha defesa!"
  },
  "1080329": {
    "ENU": "Away with thee, scum!",
    "PTB": "Fora daqui, escória!"
  },
  "1080330": {
    "ENU": "Oof! That didst hurt!",
    "PTB": "Oof! Isso doeu!"
  },
  "1080331": {
    "ENU": "Aaah! I do bleed badly...",
    "PTB": "Aaah! Estou sangrando muito..."
  },
  "1080332": {
    "ENU": "A good blow on thy part... but not enough!",
    "PTB": "Um bom golpe da tua parte... mas não o suficiente!"
  },
