  },
  "1113388": {
    "ENU": "You have been expelled from the room!"
  },
  "1113389": {
    "ENU": "As long as you carry this key, you will be granted access to the Puzzle Room."
  },
  "1113390": {
    "ENU": "Puzzle Room Timer"
  },
  "1113391": {
    "ENU": "Click CANCEL to read the instruction book or OK to start the timer now."
  },
  "1113392": {
    "ENU": "You may only receive one of these once every 2 hours."
  },
  "1113393": {
    "ENU": "You must carry a magic key to enter this room."
  },
  "1113394": {
    "ENU": "Puzzling Invitation"
  },
  "1113395": {
    "ENU": "Sir Wilbur"
  },
  "1113396": {
    "ENU": "Greetings Traveler!<br><br>I would like to invite you to a little game. See this Magic Key? It will grant you access to the"
  },
  "1113397": {
    "ENU": "Puzzle Room. Be advised that once you take the key, you will have no more than 30 minutes to enter the room and solve the puzzles. If you "
  },
  "1113398": {
    "ENU": "fail, you will be expelled and all your progress will be lost! There are 3 puzzles chests. Two of them must be completed first to unlock the third."
  },
  "1113399": {
    "ENU": "If successful, you will get a special item required to enter my other playground should you discover its location within the Underworld!!"
  },
  "1113400": {
    "ENU": "You fail to neutralize the gem in time and are expelled from the room!!"
  },
  "1113401": {
    "ENU": "The state of your gem worsens!!"
  },
  "1113402": {
    "ENU": "The next room has been unlocked! Hurry through the door before your gem's state changes again!"
  },
  "1113403": {
    "ENU": "Congratulations!! The last room has been unlocked!! Hurry through to claim your reward!"
  },
  "1113404": {
    "ENU": "You did not cross into the next room in time. You have been expelled from the room."
  },
