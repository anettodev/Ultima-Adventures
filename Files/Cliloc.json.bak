  "1072338": {
    "ENU": "I do not have any opportunities for you at this time.  If you ask me again later though, I may have something new for you to consider."
  },
  "1072339": {
    "ENU": "Proof of the Deed"
  },
  "1072340": {
    "ENU": "These human vermin must be eradicated!  They despoil fair Sosaria with their every footfall upon her soil, every exhalation of breath upon her pristine air.  Prove yourself an ally of Sosaria and bring me 20 human ears as proof of your devotion to our cause."
  },
  "1072341": {
    "ENU": "A bag of trinkets."
  },
  "1072342": {
    "ENU": "Do you find the task distasteful?  Are you too weak to shoulder the duty of cleansing Sosaria?  So be it."
  },
  "1072343": {
    "ENU": "Well, where is the proof of your deed?  I will honor your actions when you have brought me the ears of the human scum."
  },
  "1072344": {
    "ENU": "Ah, well done.  You have chosen the path of duty and fulfilled your task with honor."
  },
  "1072345": {
    "ENU": "Broadswords for victory!"
  },
  "1072346": {
    "ENU": "To win this war, our fighters need replacement weapons.  Bring me broadswords and I will reward you."
  },
  "1072347": {
    "ENU": "You haven't brought enough broadsword, come back you have all that I need."
  },
  "1072348": {
    "ENU": "Weapons courier."
  },
  "1072349": {
    "ENU": "I need you to deliver some weapons on my behalf.  You will be rewarded when the items are received."
  },
  "1072350": {
    "ENU": "Deliver the weapons as instructed.  Only then will you be rewarded."
  },
