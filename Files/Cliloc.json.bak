  },
  "1115281": {
    "ENU": "Plays animations for mobiles when they are standing still. Restart is required for the change to take effect."
  },
  "1115282": {
    "ENU": "The variety of animations to play for mobiles. The \"Low\" setting eliminates any fidgeting animations (such as the occasional stretch when standing still). The \"Medium\" setting reduces the variance in animations. The \"High\" setting plays all animations available. Restart is required for the change to take effect."
  },
  "1115283": {
    "ENU": "Action to use when scrolling the mouse wheel up."
  },
  "1115284": {
    "ENU": "Action to use when scrolling the mouse wheel down."
  },
  "1115285": {
    "ENU": "Resets all key bindings to the Classic Client set. Ideal to use if the \"Legacy Chat Mode\" option is turned on, where pressing ENTER to begin chatting is not required."
  },
  "1115286": {
    "ENU": "Resets all key bindings to the Enhanced Client set. Ideal to use if the \"Legacy Chat Mode\" option is turned off, where pressing ENTER to begin chatting is required."
  },
