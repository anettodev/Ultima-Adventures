  "1072287": {
    "ENU": "I seek a worthy escort.  I can offer some small pay to any able bodied adventurer who can assist me.  It is imperative that I reach my destination."
  },
  "1072288": {
    "ENU": "I wish you would reconsider my offer.  I'll be waiting right here for someone brave enough to assist me."
