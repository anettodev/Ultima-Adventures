  "1115304": {
    "ENU": "Shows the current health, mana, and stamina values in your portrait without the need to mouse over it."
  },
  "1115305": {
    "ENU": "Shows extended mouse-over information for actions in the hotbar."
  },
  "1115306": {
    "ENU": "Shows a \"Tip of the Day\" window after logging into the game."
