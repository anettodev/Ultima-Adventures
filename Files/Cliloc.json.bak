  "1007000": {
    "ENU": "Aye."
  },
  "1007001": {
    "ENU": "Nay."
  },
  "1007002": {
    "ENU": "Very doubtful."
  },
  "1007003": {
    "ENU": "Mine sources say nay."
  },
  "1007004": {
    "ENU": "Tis most certain."
  },
  "1007005": {
    "ENU": "Aye, verily."
  },
  "1007006": {
    "ENU": "**fizzles**"
  },
  "1007007": {
    "ENU": "Count on it not"
  },
  "1007008": {
    "ENU": "Concentrate and ask again."
  },
  "1007009": {
    "ENU": "Beyond the slightest doubt."
  },
  "1007010": {
    "ENU": "Unable to foresee."
  },
  "1007011": {
    "ENU": "Eat at the Blue Boar!"
  },
  "1007012": {
    "ENU": "Why art thou asking me?"
  },
  "1007013": {
    "ENU": "The very ground shall crumble before a thing."
  },
  "1007014": {
    "ENU": "'Twas not clear."
  },
  "1007015": {
    "ENU": "With virtue, it shall be."
  },
  "1007016": {
    "ENU": "**shimmers, crackles, and fades**"
  },
  "1007017": {
    "ENU": "Only a fool would ask such."
  },
  "1007018": {
    "ENU": "If I say, 'yea', wilt thou leave?"
  },
  "1007019": {
    "ENU": "A plague on thee if thou doth ask again."
  },
  "1007020": {
    "ENU": "Tis no surprise that I'd say aye'."
  },
  "1007021": {
    "ENU": "Truth is tough. It will not break."
  },
  "1007022": {
    "ENU": "Keep from me the divinity of Yes and No."
  },
  "1007023": {
    "ENU": "Who then is going to say Nay?"
  },
  "1007024": {
    "ENU": "T'is no good arguing with the inevitable."
  },
  "1007025": {
    "ENU": "Mondain himself could not make me say yes!"
  },
  "1007026": {
    "ENU": "Nothing left, nothing at all, nothing, nothing."
  },
  "1007027": {
    "ENU": "Best not to tell thee."
  },
  "1007028": {
    "ENU": "I shall be avenged!"
  },
  "1007029": {
    "ENU": "NOOooo!"
  },
  "1007030": {
    "ENU": "I... I..."
  },
  "1007031": {
    "ENU": "No, I don't want to die..."
  },
  "1007032": {
    "ENU": "Argh! I am slain!"
  },
  "1007033": {
    "ENU": "Must stay... on feet..."
  },
  "1007034": {
    "ENU": "Oooh, that doth hurt..."
  },
  "1007035": {
    "ENU": "Am I dying?"
  },
  "1007036": {
    "ENU": "Whatever shall my family do without me?"
  },
  "1007037": {
    "ENU": "I hope the guards catch thee, scum!"
  },
  "1007038": {
    "ENU": "Ooh... that doth hurt!"
  },
  "1007039": {
    "ENU": "Must I die?"
  },
  "1007040": {
    "ENU": "Curse thee!"
  },
  "1007041": {
    "ENU": "I shall be avenged..."
  },
  "1007042": {
    "ENU": "I shall haunt thee for this deed!"
  },
  "1007043": {
    "ENU": "I spit on thee!"
  },
  "1007044": {
    "ENU": "Ha! I knew that I could do it!"
  },
  "1007045": {
    "ENU": "Thou shouldst not have messed with me!"
  },
  "1007046": {
    "ENU": "Die, pathetic fool!"
  },
  "1007047": {
    "ENU": "Thou deservest to die!"
  },
  "1007048": {
    "ENU": "There, that taketh care of thee."
  },
  "1007049": {
    "ENU": "So perish those who challenge me!"
  },
  "1007050": {
    "ENU": "Thou shouldst not have fought me."
  },
  "1007051": {
    "ENU": "May thy soul rest in peace."
  },
  "1007052": {
    "ENU": "May thy shade wander the wilderness forever!"
  },
  "1007053": {
    "ENU": "Have done with thee!"
  },
  "1007054": {
    "ENU": "Ha! Thou art inept!"
  },
  "1007055": {
    "ENU": "Thou didst miss, fool!"
  },
  "1007056": {
    "ENU": "Thy aim is bad..."
  },
  "1007057": {
    "ENU": "Surely thou canst do better than that blow!"
  },
  "1007058": {
    "ENU": "Thou dost hit only air!"
  },
  "1007059": {
    "ENU": "Thou art no match for me!"
  },
  "1007060": {
    "ENU": "Ouch! Thou didst scratch me!"
  },
  "1007061": {
    "ENU": "Barely a flesh wound. Canst thou not do better?"
  },
  "1007062": {
    "ENU": "Pfft, thou fightest badly."
  },
  "1007063": {
    "ENU": "Surely thou canst hit harder than that!"
  },
  "1007064": {
    "ENU": "A bare touch... Thou dost not wield thy weapon well!"
  },
  "1007065": {
    "ENU": "Ouch! A touch indeed!",
    "PTB": "Ai! Um toque e tanto!"
  },
  "1007066": {
    "ENU": "'Twill take more than that to kill me!",
    "PTB": "Vai precisar de muito mais que isso para me matar!"
  },
  "1007067": {
    "ENU": "Ow, thou didst get past my defenses!",
    "PTB": "Ai, tu passaste por minha defesa!"
  },
  "1007068": {
    "ENU": "Away with thee, scum!",
    "PTB": "Fora daqui, escória!"
  },
  "1007069": {
    "ENU": "Oof! That didst hurt!",
    "PTB": "Oof! Isso doeu!"
  },
  "1007070": {
    "ENU": "Aaah! I do bleed badly...",
    "PTB": "Aaah! Estou sangrando muito..."
  },
  "1007071": {
    "ENU": "A good blow on thy part... but not enough!",
