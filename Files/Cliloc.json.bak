  "1043310": {
    "ENU": "I live only to serve thee."
  },
  "1043311": {
    "ENU": "I do only thy bidding."
  },
  "1043312": {
    "ENU": "Together we shall make a fortune."
  },
  "1043313": {
    "ENU": "You'll not catch me skimming from the top.  You can trust me!"
  },
  "1043314": {
    "ENU": "The market will surely be good for such fine wares."
  },
  "1043315": {
    "ENU": "Oh goody!  I get to stand here and sell things. My life is complete."
  },
  "1043316": {
    "ENU": "Mother told me to become a mage, but no, I wanted a 'people' position."
  },
  "1043317": {
    "ENU": "One day, I would like to ride a horse, until then I will wait here and sell goods for you."
  },
  "1043318": {
    "ENU": "It shall be as ye say."
  },
  "1043319": {
    "ENU": "Good journeys to you."
  },
  "1043320": {
    "ENU": "Farewell to thee. Come back with exotic wares, and I will sell them."
  },
