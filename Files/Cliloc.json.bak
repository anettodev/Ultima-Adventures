  },
  "1049016": {
    "ENU": "Yes"
  },
  "1049017": {
    "ENU": "No"
  },
  "1049018": {
    "ENU": "You have declined the Quest."
  },
  "1049019": {
    "ENU": "You have accepted the Quest."
  },
