  },
  "1049487": {
    "ENU": "I already have my champions awakening skull!"
  },
  "1049488": {
    "ENU": "That is not my champions awakening skull!"
  },
  "1049489": {
    "ENU": "Altar of Rikktor"
  },
  "1049490": {
    "ENU": "Altar of Lord Oaks"
  },
  "1049491": {
