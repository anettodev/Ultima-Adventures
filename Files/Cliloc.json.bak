  "501502": {
    "ENU": "I am too busy to teach thee."
  },
  "501503": {
    "ENU": "I do not train whilst I am working."
  },
  "501504": {
    "ENU": "All known skill slots...",
    "PTB": "Todos os slots de habilidades conhecidos..."
  },
  "501505": {
    "ENU": "Alas, I cannot teach thee anything.",
    "PTB": "Ah, não posso te ensinar nada."
  },
  "501506": {
    "ENU": "Somehow I recognized a skill keyword but didn't see it the second time I checked...",
    "PTB": "De alguma forma reconheci uma palavra-chave de habilidade, mas não a vi da segunda vez que verifiquei..."
  },
  "501507": {
    "ENU": "'Tis not something I can teach thee of.",
    "PTB": "Não é algo que eu possa te ensinar."
  },
  "501508": {
    "ENU": "I cannot teach thee, for thou knowest more than I!",
    "PTB": "Não posso te ensinar, pois você sabe mais do que eu!"
  },
  "501509": {
    "ENU": "I cannot teach thee, for thou knowest all I can teach!",
    "PTB": "Não posso te ensinar, pois você já sabe tudo o que posso ensinar!"
  },
  "501510": {
    "ENU": "Make sure this skill is marked to raise. If you are near the skill cap (700 points) you may need to lose some points in another skill first.",
    "PTB": "Certifique-se de que esta habilidade está marcada para aumentar. Se você estiver perto do limite de habilidades (700 pontos), pode precisar perder alguns pontos em outra habilidade primeiro."
  },
  "501511": {
    "ENU": "I wouldn't presume to teach thee anything!",
    "PTB": "Eu não presumiria te ensinar algo!"
  },
  "501512": {
    "ENU": "Thou hast not learned enough of other ways to be taught this skill.",
    "PTB": "Você não aprendeu o suficiente de outros métodos para ser ensinado nesta habilidade."
  },
  "501513": {
    "ENU": "I recognize that name!",
    "PTB": "Reconheço esse nome!"
  },
  "501514": {
    "ENU": "Speaker asked about himself.",
    "PTB": "Perguntador perguntou sobre si mesmo."
  },
  "501515": {
    "ENU": "Found something!",
    "PTB": "Encontrei algo!"
  },
  "501516": {
    "ENU": "Excuse me?",
    "PTB": "Com licença?"
  },
  "501517": {
    "ENU": "Being asked where something is.",
    "PTB": "Sendo perguntado sobre a direção de algo."
  },
  "501518": {
    "ENU": "Asked direction to nowhere I recognize.",
    "PTB": "Perguntado sobre direção para lugar nenhum que eu reconheça."
  },
  "501519": {
    "ENU": "I know not where to find that.",
    "PTB": "Não sei onde encontrar isso."
  },
  "501520": {
    "ENU": "I had just stored my need.",
    "PTB": "Acabei de guardar minha necessidade."
  },
  "501521": {
    "ENU": "I am open from five in the morn until eleven at night.",
    "PTB": "Estou aberto das cinco da manhã até as onze da noite."
  },
  "501522": {
    "ENU": "I shall not treat with scum like thee!",
    "PTB": "Não tratarei com escória como você!"
  },
  "501523": {
    "ENU": "I shall not treat with scum like thee!",
    "PTB": "Não tratarei com escória como você!"
  },
  "501524": {
    "ENU": "I shall not treat with scum like thee!",
    "PTB": "Não tratarei com escória como você!"
  },
  "501525": {
    "ENU": "I am sorry, I do not have my wares here with me. Let us go back to my shop.",
    "PTB": "Desculpe, não tenho meus produtos aqui comigo. Vamos voltar para minha loja."
  },
  "501526": {
    "ENU": "Alas, I have no shop! I cannot do business with thee.",
    "PTB": "Ah, não tenho loja! Não posso fazer negócios com você."
  },
  "501527": {
    "ENU": "Hours are from five in the morn until eleven at night.",
    "PTB": "Horário de funcionamento das cinco da manhã até as onze da noite."
  },
  "501528": {
    "ENU": "As thou'rt of my same guild, I shall discount my wares to thee.",
    "PTB": "Como você é do meu mesmo guild, vou dar desconto nos meus produtos."
  },
  "501529": {
    "ENU": "Art thou trying to bribe me?",
    "PTB": "Está tentando me subornar?"
  },
  "501530": {
    "ENU": "I might be interested in buying this of thee.",
    "PTB": "Posso estar interessado em comprar isso de você."
  },
  "501531": {
    "ENU": "I am teaching!",
    "PTB": "Estou ensinando!"
  },
  "501532": {
    "ENU": "And the asker is learning.",
    "PTB": "E o perguntador está aprendendo."
  },
  "501533": {
    "ENU": "And we agree on what to learn.",
    "PTB": "E concordamos no que aprender."
  },
  "501534": {
    "ENU": "Failed to get gold resource on item.",
    "PTB": "Falha ao obter recurso de ouro no item."
  },
  "501535": {
    "ENU": "I require gold in payment!",
    "PTB": "Exijo ouro em pagamento!"
  },
  "501536": {
    "ENU": "'Tis but a pittance! I require 10 gold at a minimum.",
    "PTB": "É apenas uma ninharia! Exijo no mínimo 10 de ouro."
  },
  "501537": {
    "ENU": "And I was paid.",
    "PTB": "E fui pago."
  },
  "501538": {
    "ENU": "Overpaid, even.",
    "PTB": "Até pago demais."
  },
  "501539": {
    "ENU": "Let me show thee something of how this is done.",
    "PTB": "Deixe-me mostrar como isso é feito."
  },
  "501540": {
