  "3000014": {
    "ENU": "The client could not attach to the game server. It must have been taken down, please wait a few minutes and try again."
  },
  "3000015": {
    "ENU": "Due to the popularity of the recently released Ultima Online: Mondain's Legacy this shard is at maximum capacity.  We’re sorry you can’t log on at this time.  Please try again in an hour or create a new character on a different shard.  Thank you for playing Ultima Online!  We hope to see you in Sosaria soon."
  },
  "3000016": {
    "ENU": "Couldn't connect to Ultima Online.  Please try again in a few moments."
