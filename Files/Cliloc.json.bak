  "1062277": {
    "ENU": "Color:"
  },
  "1062278": {
    "ENU": "This is what I want"
  },
  "1062279": {
    "ENU": "No, let me make another selection."
  },
  "1062280": {
    "ENU": "To ~1_CHARNAME~, on behalf of your Age of Shadows team"
  },
  "1062281": {
    "ENU": "To ~1_CHARNAME~, for helping to usher in the Age of Shadows"
  },
  "1062282": {
    "ENU": "~1_CHARNAME~ was there for the Age of Shadows launch!"
  },
  "1062283": {
