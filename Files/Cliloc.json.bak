  },
  "1049496": {
    "ENU": "Champions must be sacrificed to summon enlightenment..."
  },
  "1049497": {
    "ENU": "The altars must be used to fulfill the prophecy..."
  },
  "1049498": {
    "ENU": "dark moongate"
  },
  "1049499": {
    "ENU": "Behold my true form!"
