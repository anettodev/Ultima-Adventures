  "1019034": {
    "ENU": "The connection between your spirit and body is too weak to resurrect.  You will have to wait a while."
  },
  "1019035": {
    "ENU": "You are overloaded.  Carrying stones / Max stones"
  },
  "1019036": {
    "ENU": "You have successfully obtained a respectable skill level, and have outgrown your status as a young player!"
  },
  "1019037": {
    "ENU": "You have grown into a respectably strong person, and have outgrown your status as a young player!"
  },
  "1019038": {
    "ENU": "You are old enough to be considered an adult, and have outgrown your status as a young player!"
  },
  "1019039": {
    "ENU": "You are no longer considered a young player of Ultima Online, and are no longer subject to the limitations and benefits of being in that caste."
