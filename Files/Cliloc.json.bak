  },
  "1115832": {
    "ENU": "Ophidians have lost ~1_VAL~ of ~2_VAL~ from wave ~3_VAL~ of their front line."
  },
  "1115833": {
    "ENU": "Bane Chosen have lost ~1_VAL~ of ~2_VAL~ from wave ~3_VAL~ of their front line."
  },
  "1115834": {
    "ENU": "Final Ban Confirmation"
  },
